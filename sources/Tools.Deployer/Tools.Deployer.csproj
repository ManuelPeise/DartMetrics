<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-Oberfläche für das Docker-Deployment: bearbeitet die .env und ruft die Skripte in deploy\ auf. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DartMetricsDeployer</AssemblyName>
    <RootNamespace>Tools.Deployer</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Damit "dotnet build DartMetrics.slnx" auch unter Linux (CI) durchläuft. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Eine einzelne .exe ohne installiertes .NET: Befehl siehe README.md (Abschnitt "Veröffentlichen"). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
