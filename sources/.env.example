# DartMetrics - Umgebungsvariablen für docker compose
# Kopieren nach .env (liegt neben docker-compose.yml) und die Platzhalter ersetzen.
# .env enthält Passwörter und gehört NIE ins Git (steht in .gitignore).

# ---------------------------------------------------------------------------
# Umgebung
# ---------------------------------------------------------------------------
# Entwicklung (PC): leer lassen -> docker-compose.override.yml wird automatisch geladen
# Produktion (Pi):  nur die Basisdatei verwenden (keine offenen DB/API-Ports, kein Mailpit)
# COMPOSE_FILE=docker-compose.yml

# ---------------------------------------------------------------------------
# Datenbank (MySQL)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Signaturschlüssel für JWT, mindestens 32 Zeichen. Erzeugen z. B. mit:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Linux:      openssl rand -base64 48
JWT_KEY=change-me-at-least-32-characters-long-random-string

# Erster Admin (wird beim ersten Start angelegt; muss das Passwort beim ersten Login ändern)
ADMIN_EMAIL=admin@dart.local
ADMIN_PASSWORD=change-me-admin-password

# Development = Swagger unter http://localhost:8080/swagger. Standard: Development mit Override, sonst Production.
# API_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# E-Mail (nur Produktion; in der Entwicklung fängt Mailpit alle Mails ab: http://localhost:8025)
# ---------------------------------------------------------------------------
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_ENABLE_SSL=true

# ---------------------------------------------------------------------------
# Web-App (Blazor)
# ---------------------------------------------------------------------------
# Passwort des HTTPS-Zertifikats ./certs/dartmetrics.pfx. Dev-Zertifikat erzeugen:
#   dotnet dev-certs https -ep certs/dartmetrics.pfx -p <passwort>
#   dotnet dev-certs https --trust
CERT_PASSWORD=change-me-cert-password

# Öffentliche Adresse der Web-App (für die Links in E-Mails)
WEB_APP_HOST=https://localhost
WEB_APP_PORT=7254

# Hinter Reverse Proxy / Tunnel (Caddy, Cloudflare Tunnel) auf true setzen
# FORWARDED_HEADERS_ENABLED=false

# Brute-Force-Schutz: Anfragen je IP und Zeitfenster für Login, Registrierung, Passwort-Reset
# RATE_LIMIT_AUTH_PERMITS=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Impressum / Datenschutzerklärung (https://localhost:7254/impressum, /datenschutz)
# Persönliche Angaben stehen nur hier, nicht im Repository.
# ---------------------------------------------------------------------------
LEGAL_NAME=Max Mustermann
LEGAL_STREET=Musterstraße 1
LEGAL_CITY=12345 Musterstadt
# LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=kontakt@example.com
# LEGAL_PHONE=

# ---------------------------------------------------------------------------
# Löschfristen (Datenschutz) - gehören so auch in die Datenschutzerklärung
# ---------------------------------------------------------------------------
# Nicht bestätigte Registrierungen nach X Tagen löschen
# RETENTION_UNVERIFIED_DAYS=7
# Log-Einträge nach X Tagen löschen
# RETENTION_LOG_DAYS=90
