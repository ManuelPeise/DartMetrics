@using Web.App.Client.Routing

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Schriften lokal (DSGVO): kein Aufruf von Google Fonts, siehe css/fonts.css *@
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/public.css"]" />
    <link rel="stylesheet" href="@Assets["css/player.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Web.Shared/css/admin.css"]" />
    <link rel="stylesheet" href="@Assets["Web.App.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["js/caller.js"]"></script>
    <script src="@Assets["js/remote.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // /admin      -> Interactive Server (admin context, server-side only)
    // /Error, /impressum, /datenschutz -> static SSR (reine Textseiten, ohne Login und ohne JavaScript nötig)
    // all others  -> Interactive WebAssembly (no prerendering: client services exist only in WASM)
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments("/Error") || AppAreas.IsStaticPage(HttpContext.Request.Path.Value)
            ? null
            : AppAreas.IsServerArea(HttpContext.Request.Path.Value)
                ? InteractiveServer
                : new InteractiveWebAssemblyRenderMode(prerender: false);
}
