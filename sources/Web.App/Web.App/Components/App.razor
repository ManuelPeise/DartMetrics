@using Web.App.Client.Routing

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;600&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/public.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Web.Shared/css/admin.css"]" />
    <link rel="stylesheet" href="@Assets["Web.App.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // /admin      -> Interactive Server (admin context, server-side only)
    // /Error      -> static SSR
    // all others  -> Interactive WebAssembly (no prerendering: client services exist only in WASM)
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments("/Error")
            ? null
            : AppAreas.IsServerArea(HttpContext.Request.Path.Value)
                ? InteractiveServer
                : new InteractiveWebAssemblyRenderMode(prerender: false);
}
