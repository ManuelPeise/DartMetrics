@page "/admin/password"
@using global::Shared.Interfaces.Blazor.Api
@using global::Shared.Models.Authentication
@inject IAuthorizedApiClient Api
@inject NavigationManager Navigation

@*
    Passwort des Admins ändern. Beim Einmal-Passwort aus der Konfiguration (Admin-Seed) zeigt AdminLayout nur diese Seite,
    die API sperrt bis dahin alle anderen Aufrufe. Nach der Änderung: abmelden und neu anmelden (frisches Token ohne Sperre).
*@

<PageTitle>Passwort ändern – DartMetrics Admin</PageTitle>

<AdminPageHeader Eyebrow="Konto" Title="Passwort ändern"
                 Subtitle="@(Forced ? "Das Startpasswort aus der Konfiguration gilt nur einmal. Bitte lege jetzt ein eigenes Passwort fest." : "Nach der Änderung meldest du dich neu an.")" />

<AdminCard>
    <form class="adm-form" style="max-width: 480px" @onsubmit="ChangeAsync" @onsubmit:preventDefault>
        @if (_error is not null)
        {
            <div class="adm-alert" role="alert">@_error</div>
        }

        <AdminInput Id="current-password" Label="Aktuelles Passwort" Type="password" @bind-Value="_current" Disabled="_busy" />
        <AdminInput Id="new-password" Label="Neues Passwort" Type="password" Hint="@PasswordPolicy.Description" @bind-Value="_new" Disabled="_busy" />
        <AdminInput Id="repeat-password" Label="Neues Passwort wiederholen" Type="password" @bind-Value="_repeat" Disabled="_busy" />

        <div class="adm-form-actions">
            <AdminButton Type="submit" IsLoading="_busy" Icon="AdminIconName.Lock">Passwort ändern</AdminButton>
        </div>
    </form>
</AdminCard>

@code {
    /// <summary>Vom Layout gesetzt, wenn das Einmal-Passwort noch gilt.</summary>
    [Parameter] public bool Forced { get; set; }

    private string? _current;
    private string? _new;
    private string? _repeat;
    private string? _error;
    private bool _busy;

    private async Task ChangeAsync()
    {
        _error = null;

        if (string.IsNullOrEmpty(_current) || string.IsNullOrEmpty(_new))
        {
            _error = "Bitte alle Felder ausfüllen.";
            return;
        }

        if (_new != _repeat)
        {
            _error = "Die neuen Passwörter stimmen nicht überein.";
            return;
        }

        _busy = true;

        try
        {
            using var response = await Api.PostAsync("Profile/ChangePassword", new ChangePasswordRequest
            {
                CurrentPassword = _current,
                Password = _new,
                PasswordReplication = _repeat
            });

            if (response.IsSuccessStatusCode)
            {
                // Neu anmelden: das alte Token trägt noch die Sperre.
                Navigation.NavigateTo("/logout", forceLoad: true);
                return;
            }

            _error = await ApiProblem.ReadMessageAsync(response);
        }
        catch
        {
            _error = "Das Passwort konnte nicht geändert werden.";
        }

        _busy = false;
    }
}
