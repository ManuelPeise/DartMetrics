@page "/admin/bots"
@using Shared.Enums.Bot
@using Shared.Interfaces.Blazor.Api
@using Shared.Models.Bot
@inject IAuthorizedApiClient Api

<PageTitle>DartBot-Verwaltung – DartMetrics Admin</PageTitle>

<AdminPageHeader Eyebrow="Verwaltung" Title="DartBots"
                 Subtitle="Virtuelle Gegner anlegen, aktivieren und ihre Entwicklung verfolgen." />

@if (_message is not null)
{
    <div class="adm-alert @(_messageIsError ? "" : "adm-alert--success")" role="status" style="margin-bottom: var(--adm-space-4)">@_message</div>
}

<div class="adm-bots-layout">
    <AdminCard Title="Alle Bots" Subtitle="Fähigkeiten aus der aktuellen Profilversion" Flush="true">
        <div class="adm-toolbar">
            <label class="adm-checkbox">
                <input type="checkbox" checked="@_includeInactive" @onchange="ToggleInactiveAsync" />
                Deaktivierte anzeigen
            </label>
            @if (_bots is not null)
            {
                <span class="adm-toolbar__meta">@_bots.Count @(_bots.Count == 1 ? "Bot" : "Bots")</span>
            }
        </div>

        <AdminTable Items="_bots" IsLoading="@(_loading && _bots is null)" ErrorText="@_loadError" OnRetry="LoadAsync">
            <HeaderTemplate>
                <th>Bot</th>
                <th>Level</th>
                <th>Elo</th>
                <th>XP</th>
                <th>Fähigkeiten</th>
                <th>Status</th>
                <th><span class="adm-sr-only">Aktionen</span></th>
            </HeaderTemplate>
            <RowTemplate Context="bot">
                <td data-label="Bot" class="adm-cell-title">
                    <strong>@bot.Name</strong>
                    <small>@bot.Alias · Profil v@(bot.ProfileVersionNumber)@(bot.PlayingStyle is null ? "" : " · " + StyleText(bot.PlayingStyle.Value))</small>
                </td>
                <td data-label="Level" class="adm-num">@bot.DevelopmentLevel</td>
                <td data-label="Elo" class="adm-num">@bot.Rating</td>
                <td data-label="XP" class="adm-num">@bot.ExperiencePoints.ToString("N0", German)</td>
                <td data-label="Skills">
                    <div class="adm-skill-bars">
                        <AdminSkillBar Label="Präzision" Value="bot.ThrowPrecision" />
                        <AdminSkillBar Label="Konstanz" Value="bot.ThrowConsistency" />
                        <AdminSkillBar Label="Taktik" Value="bot.TacticalIntelligence" />
                        <AdminSkillBar Label="Druck" Value="bot.PressureResistance" />
                        <AdminSkillBar Label="Risiko" Value="bot.RiskTaking" />
                    </div>
                </td>
                <td data-label="Status">
                    <AdminStatusBadge Text="@(bot.IsActive ? "Aktiv" : "Deaktiviert")"
                                      Status="@(bot.IsActive ? AdminStatus.Success : AdminStatus.Neutral)" />
                </td>
                <td data-label="">
                    @if (bot.IsActive)
                    {
                        <AdminButton Variant="AdminButtonVariant.Ghost" IsLoading="@(_busyBotId == bot.Id)"
                                     Disabled="@(_busyBotId is not null)" OnClick="() => SetActiveAsync(bot, false)">
                            Deaktivieren
                        </AdminButton>
                    }
                    else
                    {
                        <AdminButton Variant="AdminButtonVariant.Ghost" IsLoading="@(_busyBotId == bot.Id)"
                                     Disabled="@(_busyBotId is not null)" OnClick="() => SetActiveAsync(bot, true)">
                            Aktivieren
                        </AdminButton>
                    }
                </td>
            </RowTemplate>
            <EmptyContent>
                <AdminEmptyState Icon="AdminIconName.Bot" Title="Noch keine Bots"
                                 Text="Lege rechts den ersten Bot an. Er startet auf Level 0." />
            </EmptyContent>
        </AdminTable>
    </AdminCard>

    <AdminCard Title="Neuer Bot" Subtitle="Startet auf Level 0 mit den Startwerten aus der Konfiguration">
        <form class="adm-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <AdminInput Id="bot-name" Label="Name" @bind-Value="_name" MaxLength="100"
                        Placeholder="z. B. Robo Taylor" Error="@_nameError" Disabled="_creating" />

            <AdminInput Id="bot-alias" Label="Alias" @bind-Value="_alias" MaxLength="50"
                        Placeholder="z. B. robo-taylor" Hint="Muss eindeutig sein." Error="@_aliasError" Disabled="_creating" />

            <AdminSelect Id="bot-style" Label="Spielstil" Options="StyleOptions" @bind-Value="_style"
                         Hint="Optional, nur zur Beschreibung." Disabled="_creating" />

            <div class="adm-form-actions">
                <AdminButton Type="submit" IsLoading="_creating" Icon="AdminIconName.Bot">Bot anlegen</AdminButton>
            </div>
        </form>
    </AdminCard>
</div>

@code {
    private static readonly System.Globalization.CultureInfo German = new("de-DE");

    private static readonly IReadOnlyList<AdminSelectOption> StyleOptions =
    [
        new("", "Kein Spielstil"),
        new(nameof(DartBotPlayingStyleEnum.Balanced), "Ausgewogen"),
        new(nameof(DartBotPlayingStyleEnum.Aggressive), "Aggressiv"),
        new(nameof(DartBotPlayingStyleEnum.Defensive), "Defensiv")
    ];

    private List<DartBotListItem>? _bots;
    private bool _loading = true;
    private string? _loadError;
    private bool _includeInactive;
    private int? _busyBotId;

    private string? _name;
    private string? _alias;
    private string? _style = "";
    private string? _nameError;
    private string? _aliasError;
    private bool _creating;

    private string? _message;
    private bool _messageIsError;

    // Erst nach dem ersten interaktiven Rendern laden (sonst doppelt durch Prerendering).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Api.GetAsync($"DartBotAdministration/GetDartBots?includeInactive={_includeInactive}");

            if (response.IsSuccessStatusCode)
            {
                _bots = await response.Content.ReadFromJsonAsync<List<DartBotListItem>>() ?? [];
            }
            else
            {
                _loadError = await ApiProblem.ReadMessageAsync(response);
            }
        }
        catch
        {
            _loadError = "Die Bots konnten nicht geladen werden.";
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleInactiveAsync(ChangeEventArgs e)
    {
        _includeInactive = e.Value is true;
        await LoadAsync();
    }

    private async Task SetActiveAsync(DartBotListItem bot, bool isActive)
    {
        _busyBotId = bot.Id;
        _message = null;

        try
        {
            var action = isActive ? "ActivateDartBot" : "DeactivateDartBot";
            using var response = await Api.PostAsync($"DartBotAdministration/{action}?botId={bot.Id}");

            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"{bot.Name} wurde {(isActive ? "aktiviert" : "deaktiviert")}.", isError: false);
            }
            else
            {
                ShowMessage(await ApiProblem.ReadMessageAsync(response), isError: true);
            }
        }
        catch
        {
            ShowMessage("Die Aktion ist fehlgeschlagen.", isError: true);
        }

        _busyBotId = null;
        await LoadAsync();
    }

    private async Task CreateAsync()
    {
        _message = null;
        _nameError = string.IsNullOrWhiteSpace(_name) ? "Bitte einen Namen eingeben." : null;
        _aliasError = string.IsNullOrWhiteSpace(_alias) ? "Bitte einen Alias eingeben." : null;

        if (_nameError is not null || _aliasError is not null)
        {
            return;
        }

        _creating = true;

        try
        {
            var model = new CreateDartBotModel
            {
                Name = _name!.Trim(),
                Alias = _alias!.Trim(),
                PlayingStyle = Enum.TryParse<DartBotPlayingStyleEnum>(_style, out var style) ? style : null
            };

            using var response = await Api.PostAsync("DartBotAdministration/CreateDartBot", model);

            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"{model.Name} wurde angelegt.", isError: false);
                _name = _alias = null;
                _style = "";
                await LoadAsync();
            }
            else
            {
                var problem = await ApiProblem.ReadMessageAsync(response);

                // Doppelter Alias kommt als 400 mit Hinweis auf den Alias.
                if (problem.Contains("alias", StringComparison.OrdinalIgnoreCase))
                {
                    _aliasError = "Dieser Alias ist bereits vergeben.";
                }
                else
                {
                    ShowMessage(problem, isError: true);
                }
            }
        }
        catch
        {
            ShowMessage("Der Bot konnte nicht angelegt werden.", isError: true);
        }

        _creating = false;
    }

    private void ShowMessage(string text, bool isError)
    {
        _message = text;
        _messageIsError = isError;
    }

    private static string StyleText(DartBotPlayingStyleEnum style) => style switch
    {
        DartBotPlayingStyleEnum.Aggressive => "Aggressiv",
        DartBotPlayingStyleEnum.Defensive => "Defensiv",
        _ => "Ausgewogen"
    };
}
