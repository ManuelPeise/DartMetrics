@page "/admin"
@using global::Shared.Enums.Logger
@using global::Shared.Enums.User
@using global::Shared.Interfaces.Blazor.Api
@using global::Shared.Models.Administration.Log
@using global::Shared.Models.Administration.User
@using global::Shared.Models.Bot
@inject IAuthorizedApiClient Api

<PageTitle>Dashboard – DartMetrics Admin</PageTitle>

<AuthorizeView Roles="Admin" Context="auth">
    <section class="adm-welcome">
        <div>
            <h1 class="adm-welcome__title">@Greeting, @Name(auth.User)</h1>
            <p class="adm-welcome__text">@SystemSummary</p>
        </div>
        <p class="adm-welcome__date">
            <strong>@_now.ToString("dddd", German)</strong>
            @_now.ToString("d. MMMM yyyy", German)
        </p>
    </section>
</AuthorizeView>

<div class="adm-stat-grid">
    <AdminStatCard Label="Benutzer gesamt" Icon="AdminIconName.Users" IsLoading="_usersLoading"
                   Value="@_users?.Count.ToString()"
                   Description="@UsersDescription"
                   BadgeText="@(_usersError ? "Nicht erreichbar" : null)"
                   Status="@(_usersError ? AdminStatus.Danger : AdminStatus.Neutral)" />

    <AdminStatCard Label="Aktive Benutzer" Icon="AdminIconName.UserCheck" IsLoading="_usersLoading"
                   Value="@_users?.Count(u => u.IsActive).ToString()"
                   Description="@ActiveUsersDescription"
                   BadgeText="@(_usersError ? "Nicht erreichbar" : null)"
                   Status="@(_usersError ? AdminStatus.Danger : AdminStatus.Success)" />

    <AdminStatCard Label="DartBots" Icon="AdminIconName.Bot" IsLoading="_botsLoading"
                   Value="@_bots?.Count.ToString()"
                   Description="@BotsDescription"
                   BadgeText="@(_botsError ? "Nicht erreichbar" : null)"
                   Status="@(_botsError ? AdminStatus.Danger : AdminStatus.Neutral)" />

    <AdminStatCard Label="ML-Modelle" Icon="AdminIconName.Model"
                   Description="Verfügbare Modelle" BadgeText="Noch keine API"
                   Status="AdminStatus.Placeholder" />

    <AdminStatCard Label="Trainingssessions" Icon="AdminIconName.Training"
                   Description="Erfasste Trainings" BadgeText="Noch keine API"
                   Status="AdminStatus.Placeholder" />

    <AdminStatCard Label="Systemstatus" Icon="AdminIconName.Pulse" IsLoading="_healthLoading"
                   Value="@HealthValue"
                   Description="@HealthDescription"
                   Status="@HealthStatus" />
</div>

<div class="adm-dashboard-grid">
    <AdminCard Title="Systemübersicht" Subtitle="Status der Komponenten" Flush="true">
        <ul class="adm-status-list">
            <li>
                <span class="adm-status-list__name">
                    <AdminIcon Name="AdminIconName.Server" />
                    <span>API<small>DartMetrics Service.Api</small></span>
                </span>
                @if (_healthLoading)
                {
                    <span class="adm-spinner" role="status"><span class="adm-sr-only">Wird geprüft</span></span>
                }
                else
                {
                    <AdminStatusBadge Text="@(_apiHealthy == true ? "Erreichbar" : "Nicht erreichbar")" Status="HealthStatus" />
                }
            </li>
            <li>
                <span class="adm-status-list__name">
                    <AdminIcon Name="AdminIconName.Database" />
                    <span>Datenbank<small>Geprüft über die Benutzerabfrage</small></span>
                </span>
                @if (_usersLoading)
                {
                    <span class="adm-spinner" role="status"><span class="adm-sr-only">Wird geprüft</span></span>
                }
                else
                {
                    <AdminStatusBadge Text="@(_usersError ? "Nicht erreichbar" : "Verbunden")"
                                      Status="@(_usersError ? AdminStatus.Danger : AdminStatus.Success)" />
                }
            </li>
            <li>
                <span class="adm-status-list__name">
                    <AdminIcon Name="AdminIconName.Model" />
                    <span>ML-Modelle<small>Aktive Modelle je Typ</small></span>
                </span>
                <AdminStatusBadge Text="Keine Prüfung verfügbar" Status="AdminStatus.Placeholder" />
            </li>
            <li>
                <span class="adm-status-list__name">
                    <AdminIcon Name="AdminIconName.Process" />
                    <span>Hintergrundprozesse<small>Training, Exporte</small></span>
                </span>
                <AdminStatusBadge Text="Keine eingerichtet" Status="AdminStatus.Neutral" />
            </li>
        </ul>
    </AdminCard>

    <AdminCard Title="Letzte Aktivitäten" Subtitle="Neueste Systemereignisse aus dem Log" Flush="true">
        <Actions>
            <a href="/admin/logs" class="adm-btn adm-btn--ghost">Alle Logs</a>
        </Actions>
        <ChildContent>
            <AdminTable Items="_recentLogs" IsLoading="_logsLoading" ErrorText="@_logsError" OnRetry="LoadLogsAsync">
                <HeaderTemplate>
                    <th>Typ</th>
                    <th>Modul</th>
                    <th>Meldung</th>
                    <th>Zeitpunkt</th>
                </HeaderTemplate>
                <RowTemplate Context="log">
                    <td data-label="Typ"><AdminStatusBadge Text="@TypeText(log.MessageType)" Status="TypeStatus(log.MessageType)" /></td>
                    <td data-label="Modul" class="adm-table__muted">@log.Module</td>
                    <td data-label="Meldung"><span class="adm-table__message" title="@log.Message">@log.Message</span></td>
                    <td data-label="Zeit" class="adm-table__muted">@FormatTime(log.CreatedAt)</td>
                </RowTemplate>
                <EmptyContent>
                    <AdminEmptyState Title="Keine Aktivitäten" Text="Es wurden noch keine Systemereignisse protokolliert." />
                </EmptyContent>
            </AdminTable>
        </ChildContent>
    </AdminCard>
</div>

@code {
    private const int RecentLogCount = 8;

    private static readonly System.Globalization.CultureInfo German = new("de-DE");

    private readonly DateTime _now = ToLocal(DateTime.UtcNow);

    private bool _healthLoading = true;
    private bool? _apiHealthy;

    private bool _usersLoading = true;
    private bool _usersError;
    private List<AdminUserListItem>? _users;

    private bool _botsLoading = true;
    private bool _botsError;
    private List<DartBotListItem>? _bots;

    private bool _logsLoading = true;
    private string? _logsError;
    private List<LogmessageExportModel>? _logs;
    private List<LogmessageExportModel>? _recentLogs;

    // Erst nach dem ersten interaktiven Rendern laden (sonst doppelt durch Prerendering).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.WhenAll(LoadHealthAsync(), LoadUsersAsync(), LoadBotsAsync(), LoadLogsAsync());
        }
    }

    private async Task LoadHealthAsync()
    {
        try
        {
            using var response = await Api.GetAsync("Health/GetHealth");
            _apiHealthy = response.IsSuccessStatusCode;
        }
        catch
        {
            _apiHealthy = false;
        }

        _healthLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUsersAsync()
    {
        (_users, _usersError) = await GetListAsync<AdminUserListItem>("UserAdministration/GetUsers");
        _usersLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBotsAsync()
    {
        (_bots, _botsError) = await GetListAsync<DartBotListItem>("DartBotAdministration/GetDartBots?includeInactive=true");
        _botsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLogsAsync()
    {
        _logsLoading = true;
        _logsError = null;
        await InvokeAsync(StateHasChanged);

        var (logs, failed) = await GetListAsync<LogmessageExportModel>("MessageLog/GetMessageLogs");

        _logs = logs;
        _recentLogs = logs?.OrderByDescending(l => l.CreatedAt).Take(RecentLogCount).ToList();
        _logsError = failed ? "Die System-Logs sind gerade nicht erreichbar." : null;
        _logsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<(List<T>? Items, bool Failed)> GetListAsync<T>(string uri)
    {
        try
        {
            using var response = await Api.GetAsync(uri);

            if (!response.IsSuccessStatusCode)
            {
                return (null, true);
            }

            return (await response.Content.ReadFromJsonAsync<List<T>>() ?? [], false);
        }
        catch
        {
            return (null, true);
        }
    }

    private string Greeting => _now.Hour switch
    {
        < 11 => "Guten Morgen",
        < 18 => "Guten Tag",
        _ => "Guten Abend"
    };

    /// <summary>Kurzfassung: API-Status und Fehler/Warnungen der letzten 24 Stunden.</summary>
    private string SystemSummary
    {
        get
        {
            if (_apiHealthy is null)
            {
                return "Systemzustand wird geprüft …";
            }

            if (_apiHealthy == false)
            {
                return "Die API ist nicht erreichbar. Bitte den Dienst prüfen.";
            }

            if (_logs is null)
            {
                return "Die API ist erreichbar.";
            }

            var since = DateTime.UtcNow.AddHours(-24);
            var recent = _logs.Where(l => DateTime.SpecifyKind(l.CreatedAt, DateTimeKind.Utc) >= since).ToList();
            var errors = recent.Count(l => l.MessageType == LogMessageTypeEnum.Error);
            var warnings = recent.Count(l => l.MessageType == LogMessageTypeEnum.Warning);

            return errors == 0 && warnings == 0
                ? "Alle Dienste erreichbar. Keine Fehler oder Warnungen in den letzten 24 Stunden."
                : $"Alle Dienste erreichbar. {Plural(errors, "Fehler", "Fehler")} und {Plural(warnings, "Warnung", "Warnungen")} in den letzten 24 Stunden.";
        }
    }

    private string UsersDescription =>
        _users is null
            ? "Registrierte Konten"
            : $"{_users.Count(u => u.Role == UserRoleEnum.Player)} Player · {_users.Count(u => u.Role == UserRoleEnum.GameMaster)} GameMaster · {_users.Count(u => u.Role == UserRoleEnum.Admin)} Admins";

    private string ActiveUsersDescription =>
        _users is null
            ? "Aktive Konten"
            : $"{_users.Count(u => !u.IsActive)} deaktiviert · {_users.Count(u => !u.IsEmailVerified)} E-Mail unbestätigt";

    private string BotsDescription =>
        _bots is null ? "Virtuelle Gegner" : $"{_bots.Count(b => b.IsActive)} aktiv, {_bots.Count(b => !b.IsActive)} deaktiviert";

    private string? HealthValue => _apiHealthy switch
    {
        true => "OK",
        false => "Fehler",
        null => null
    };

    private string HealthDescription => _apiHealthy == false ? "API nicht erreichbar" : "Erreichbarkeit der API";

    private AdminStatus HealthStatus => _apiHealthy switch
    {
        true => AdminStatus.Success,
        false => AdminStatus.Danger,
        null => AdminStatus.Neutral
    };

    private static string Plural(int count, string one, string many) => $"{count} {(count == 1 ? one : many)}";

    private static string TypeText(LogMessageTypeEnum type) => type switch
    {
        LogMessageTypeEnum.Error => "Fehler",
        LogMessageTypeEnum.Warning => "Warnung",
        _ => "Info"
    };

    private static AdminStatus TypeStatus(LogMessageTypeEnum type) => type switch
    {
        LogMessageTypeEnum.Error => AdminStatus.Danger,
        LogMessageTypeEnum.Warning => AdminStatus.Warning,
        _ => AdminStatus.Neutral
    };

    private static string FormatTime(DateTime createdAt) =>
        ToLocal(DateTime.SpecifyKind(createdAt, DateTimeKind.Utc)).ToString("dd.MM.yyyy HH:mm", German);

    private static DateTime ToLocal(DateTime utc)
    {
        try
        {
            return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("Europe/Berlin"));
        }
        catch (TimeZoneNotFoundException)
        {
            return utc.ToLocalTime();
        }
    }

    private static string Name(System.Security.Claims.ClaimsPrincipal user)
    {
        var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        return string.IsNullOrEmpty(email) ? "Administrator" : email.Split('@')[0];
    }
}
