@page "/admin/models"
@using global::Shared.Enums.Bot
@using global::Shared.Interfaces.Blazor.Api
@using global::Shared.Models.Bot
@inject IAuthorizedApiClient Api
@implements IDisposable

<PageTitle>ML-Modellverwaltung – DartMetrics Admin</PageTitle>

<AdminPageHeader Eyebrow="Administration" Title="ML-Modellverwaltung"
                 Subtitle="Zielwahl-Modelle der DartBots trainieren, prüfen und aktivieren. Training und Vergleich laufen im BotTrainer-Container." />

@if (_message is not null)
{
    <div class="adm-alert @(_messageIsError ? "" : "adm-alert--success")" role="status" style="margin-bottom: var(--adm-space-4)">@_message</div>
}

<div class="adm-stat-grid">
    <AdminStatCard Label="Aktives Modell" Icon="AdminIconName.Model" IsLoading="@(_overview is null && _loading)"
                   Value="@(ActiveModel is null ? null : $"Version {ActiveModel.VersionNumber}")"
                   Description="@(ActiveModel is null ? "Bots spielen regelbasiert" : $"seit {ActiveModel.ActivatedAt?.ToLocalTime().ToString("g", German)}")"
                   BadgeText="@(ActiveModel is null ? "Regelwerk" : "Hybrid")"
                   Status="@(ActiveModel is null ? AdminStatus.Neutral : AdminStatus.Success)" />
    <AdminStatCard Label="Schwelle" Icon="AdminIconName.Model" IsLoading="@(_overview is null && _loading)"
                   Value="@(_overview?.Margin.ToString("0.0#", German))"
                   Description="So viele Darts muss das Modell besser sein, um das Regel-Ziel zu ersetzen (DartBot:Ml:Margin)." />
    <AdminStatCard Label="ML in der API" Icon="AdminIconName.Bot" IsLoading="@(_overview is null && _loading)"
                   Value="@(_overview is null ? null : _overview.MlEnabled ? "Eingeschaltet" : "Ausgeschaltet")"
                   Description="@(_overview is null ? null : $"Erwartetes Schema: {_overview.ExpectedFeatureSchemaVersion}")"
                   Status="@(_overview?.MlEnabled == false ? AdminStatus.Warning : AdminStatus.Neutral)" />
</div>

<AdminCard Title="Neues Modell trainieren" Subtitle="Datensatz erzeugen, trainieren und gegen das Regelwerk vergleichen. Aktiviert wird nur von Hand.">
    @if (CurrentJob is not null)
    {
        <div class="adm-form">
            <div style="display:flex; gap: var(--adm-space-3); align-items:center; flex-wrap:wrap">
                <strong>Auftrag @CurrentJob.Id · @PresetText(CurrentJob.Preset)</strong>
                <AdminStatusBadge Text="@JobStatusText(CurrentJob)" Status="@JobStatus(CurrentJob)" />
                @if (CurrentJob.Phase is not null)
                {
                    <small>Schritt @PhaseNumber(CurrentJob.Phase.Value)/3: @PhaseText(CurrentJob.Phase.Value)</small>
                }
            </div>
            <AdminSkillBar Label="Fortschritt" Value="@(CurrentJob.ProgressPercent / 100f)" />
            <small>@CurrentJob.ProgressText</small>
            @if (CurrentJob.Status == DartBotTrainingJobStatusEnum.Queued && CurrentJob.CreatedAt < DateTime.UtcNow.AddMinutes(-1))
            {
                <div class="adm-alert" role="status">Der Auftrag wartet seit über einer Minute. Läuft der Container <code>bottrainer-worker</code>?</div>
            }
            <div class="adm-form-actions">
                <AdminButton Variant="AdminButtonVariant.Danger" IsLoading="_cancelling" Disabled="@(CurrentJob.CancelRequested)" OnClick="CancelJobAsync">
                    @(CurrentJob.CancelRequested ? "Abbruch angefordert …" : "Abbrechen")
                </AdminButton>
            </div>
        </div>
    }
    else
    {
        <form class="adm-form" @onsubmit="StartJobAsync" @onsubmit:preventDefault>
            <AdminSelect Id="job-preset" Label="Umfang" Options="PresetOptions" @bind-Value="_preset"
                         Hint="Schnell nur zum Ausprobieren (Modell meist schlechter als das Regelwerk). Standard für ein Modell, das aktiviert werden soll: auf einem PC grob 10–30 min, auf dem Raspberry Pi deutlich länger." Disabled="_starting" />
            <div class="adm-form-actions">
                <AdminButton Type="submit" IsLoading="_starting" Icon="AdminIconName.Training">Training starten</AdminButton>
            </div>
        </form>
    }
</AdminCard>

<AdminCard Title="Trainingsaufträge" Subtitle="Die letzten Aufträge aus dem Admin-Bereich." Flush="true">
    <AdminTable Items="_jobs" IsLoading="@(_jobs is null && _jobsError is null)" ErrorText="@_jobsError" OnRetry="LoadJobsAsync">
        <HeaderTemplate>
            <th>Auftrag</th>
            <th>Status</th>
            <th>Ergebnis</th>
        </HeaderTemplate>
        <RowTemplate Context="job">
            <td data-label="Auftrag" class="adm-cell-title">
                <strong>#@job.Id · @PresetText(job.Preset)</strong>
                <small>@job.CreatedAt.ToLocalTime().ToString("g", German) · @job.RequestedBy · @job.Situations Situationen · @job.CompareLegs Legs je Stufe</small>
            </td>
            <td data-label="Status" class="adm-cell-title">
                <AdminStatusBadge Text="@JobStatusText(job)" Status="@JobStatus(job)" />
                @if (job.Status == DartBotTrainingJobStatusEnum.Failed && job.ErrorMessage is not null)
                {
                    <small>@job.ErrorMessage</small>
                }
                else if (job.FinishedAt is not null && job.StartedAt is not null)
                {
                    <small>Dauer @FormatDuration(job.FinishedAt.Value - job.StartedAt.Value)</small>
                }
            </td>
            <td data-label="Ergebnis" class="adm-cell-title">
                @if (job.ModelId is not null)
                {
                    <span>Modell Version @job.ModelVersionNumber (Id @job.ModelId)</span>
                }
                @if (job.ComparisonPassed is not null)
                {
                    <AdminStatusBadge Text="@(job.ComparisonPassed.Value ? "Vergleich bestanden" : "Schlechter als Regelwerk")"
                                      Status="@(job.ComparisonPassed.Value ? AdminStatus.Success : AdminStatus.Danger)" />
                }
                else if (job.ModelId is null)
                {
                    <small>–</small>
                }
            </td>
        </RowTemplate>
        <EmptyContent>
            <AdminEmptyState Icon="AdminIconName.Training" Title="Noch keine Aufträge"
                             Text="Starte oben ein Training. Ergebnisse erscheinen danach unten bei den Zielwahl-Modellen." />
        </EmptyContent>
    </AdminTable>
</AdminCard>

<AdminCard Title="Zielwahl-Modelle" Subtitle="Neue Bot-Spiele nutzen das aktive Modell; laufende Spiele behalten ihres." Flush="true">
    <div class="adm-toolbar">
        @if (ActiveModel is not null)
        {
            <AdminButton Variant="AdminButtonVariant.Ghost" IsLoading="_deactivating" Disabled="@(_busy)" OnClick="DeactivateAsync">
                Modell deaktivieren (regelbasiert)
            </AdminButton>
        }
        @if (_overview is not null)
        {
            <span class="adm-toolbar__meta">@_overview.Models.Count @(_overview.Models.Count == 1 ? "Modell" : "Modelle")</span>
        }
    </div>

    <AdminTable Items="_overview?.Models" IsLoading="@(_loading && _overview is null)" ErrorText="@_loadError" OnRetry="LoadAsync">
        <HeaderTemplate>
            <th>Modell</th>
            <th>Training</th>
            <th>Vergleich gegen Regelwerk</th>
            <th>Datei</th>
            <th>Status</th>
            <th><span class="adm-sr-only">Aktionen</span></th>
        </HeaderTemplate>
        <RowTemplate Context="model">
            <td data-label="Modell" class="adm-cell-title">
                <strong>Version @model.VersionNumber</strong>
                <small>Id @model.Id · @model.CreatedAt.ToLocalTime().ToString("g", German) · @FormatSize(model.SizeBytes)</small>
            </td>
            <td data-label="Training" class="adm-cell-title">
                <span>Datensatz @model.DatasetId · @model.DatasetRowCount.ToString("N0", German) Zeilen</span>
                <small>
                    Schema @model.FeatureSchemaVersion · ML.NET @model.MlNetVersion
                    @if (model.TopChoiceHitRate is not null)
                    {
                        <text> · Treffer @model.TopChoiceHitRate.Value.ToString("P1", German)</text>
                    }
                    @if (model.TopChoiceMeanRegret is not null)
                    {
                        <text> · Regret @model.TopChoiceMeanRegret.Value.ToString("0.00", German)</text>
                    }
                </small>
            </td>
            <td data-label="Vergleich">
                @{ var levels = LevelsFor(model); }
                @if (levels.Count == 0)
                {
                    <small>Noch nicht verglichen</small>
                }
                else
                {
                    <ul class="adm-status-list">
                        @foreach (var level in levels)
                        {
                            <li>
                                <span>Skill @level.Skill.ToString("0.00", German)</span>
                                <span class="adm-num" title="95-%-Intervall @level.Ci95Low.ToString("0.00", German) bis @level.Ci95High.ToString("0.00", German) · abgewichen @level.OverrideShare.ToString("P1", German)">
                                    @level.MeanDifference.ToString("+0.00;−0.00;0.00", German) Darts
                                </span>
                                <AdminStatusBadge Text="@VerdictText(level)" Status="@VerdictStatus(level)" />
                            </li>
                        }
                    </ul>
                    <small>Schwelle @levels[0].Margin.ToString("0.0#", German) · @model.ComparedLegsPerLevel Legs je Stufe · @model.ComparedAt?.ToLocalTime().ToString("d", German)</small>
                }
            </td>
            <td data-label="Datei">
                <AdminStatusBadge Text="@FileText(model.FileStatus)" Status="@(model.FileStatus == DartBotModelFileStatusEnum.Ok ? AdminStatus.Success : AdminStatus.Danger)" />
            </td>
            <td data-label="Status">
                <AdminStatusBadge Text="@(model.IsActive ? "Aktiv" : "Inaktiv")"
                                  Status="@(model.IsActive ? AdminStatus.Success : AdminStatus.Neutral)" />
            </td>
            <td data-label="">
                @if (!model.IsActive)
                {
                    <AdminButton Variant="AdminButtonVariant.Ghost" IsLoading="@(_busyModelId == model.Id)"
                                 Disabled="@(_busy || model.FileStatus != DartBotModelFileStatusEnum.Ok)"
                                 OnClick="() => ActivateAsync(model)">
                        Aktivieren
                    </AdminButton>
                }
            </td>
        </RowTemplate>
        <EmptyContent>
            <AdminEmptyState Icon="AdminIconName.Model" Title="Noch keine Modelle"
                             Text="Starte oben ein Training oder nutze Tools.BotTrainer (generate, train, compare)." />
        </EmptyContent>
    </AdminTable>
</AdminCard>

@code {
    private static readonly System.Globalization.CultureInfo German = new("de-DE");

    private DartBotModelOverview? _overview;
    private bool _loading = true;
    private string? _loadError;
    private int? _busyModelId;
    private bool _deactivating;

    private string? _message;
    private bool _messageIsError;

    private bool _busy => _busyModelId is not null || _deactivating;

    private DartBotModelListItem? ActiveModel => _overview?.Models.FirstOrDefault(m => m.IsActive);

    private static readonly IReadOnlyList<AdminSelectOption> PresetOptions =
    [
        new(nameof(DartBotTrainingJobPresetEnum.Quick), "Schnell – 3.000 Situationen, 500 Vergleichs-Legs (Funktionstest)"),
        new(nameof(DartBotTrainingJobPresetEnum.Standard), "Standard – 20.000 Situationen, 2.000 Vergleichs-Legs")
    ];

    private List<DartBotTrainingJobListItem>? _jobs;
    private string? _jobsError;
    private string? _preset = nameof(DartBotTrainingJobPresetEnum.Quick);
    private bool _starting;
    private bool _cancelling;
    private System.Threading.Timer? _pollTimer;
    private bool _disposed;

    private DartBotTrainingJobListItem? CurrentJob => _jobs?.FirstOrDefault(j =>
        j.Status is DartBotTrainingJobStatusEnum.Queued or DartBotTrainingJobStatusEnum.Running);

    // Erst nach dem ersten interaktiven Rendern laden (sonst doppelt durch Prerendering).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.WhenAll(LoadAsync(), LoadJobsAsync());
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Api.GetAsync("DartBotModelAdministration/GetDartBotModels");

            if (response.IsSuccessStatusCode)
            {
                _overview = await response.Content.ReadFromJsonAsync<DartBotModelOverview>();
            }
            else
            {
                _loadError = await ApiProblem.ReadMessageAsync(response);
            }
        }
        catch
        {
            _loadError = "Die Modelle konnten nicht geladen werden.";
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ActivateAsync(DartBotModelListItem model)
    {
        _busyModelId = model.Id;
        _message = null;

        try
        {
            using var response = await Api.PostAsync($"DartBotModelAdministration/ActivateDartBotModel?modelId={model.Id}");

            if (response.IsSuccessStatusCode)
            {
                ShowMessage($"Version {model.VersionNumber} ist aktiv. Gilt für neu gestartete Bot-Spiele.", isError: false);
            }
            else
            {
                ShowMessage(await ApiProblem.ReadMessageAsync(response), isError: true);
            }
        }
        catch
        {
            ShowMessage("Das Modell konnte nicht aktiviert werden.", isError: true);
        }

        _busyModelId = null;
        await LoadAsync();
    }

    private async Task DeactivateAsync()
    {
        _deactivating = true;
        _message = null;

        try
        {
            using var response = await Api.PostAsync("DartBotModelAdministration/DeactivateDartBotModel");

            if (response.IsSuccessStatusCode)
            {
                ShowMessage("Kein Modell aktiv: neue Bot-Spiele sind regelbasiert.", isError: false);
            }
            else
            {
                ShowMessage(await ApiProblem.ReadMessageAsync(response), isError: true);
            }
        }
        catch
        {
            ShowMessage("Das Modell konnte nicht deaktiviert werden.", isError: true);
        }

        _deactivating = false;
        await LoadAsync();
    }

    private async Task LoadJobsAsync()
    {
        var hadCurrentJob = CurrentJob is not null;
        _jobsError = null;

        try
        {
            using var response = await Api.GetAsync("DartBotTrainingJobAdministration/GetDartBotTrainingJobs?take=10");

            if (response.IsSuccessStatusCode)
            {
                _jobs = await response.Content.ReadFromJsonAsync<List<DartBotTrainingJobListItem>>() ?? [];
            }
            else
            {
                _jobsError = await ApiProblem.ReadMessageAsync(response);
            }
        }
        catch
        {
            _jobsError = "Die Trainingsaufträge konnten nicht geladen werden.";
        }

        // Auftrag gerade fertig geworden: neues Modell in der Liste zeigen.
        if (hadCurrentJob && CurrentJob is null && _jobsError is null)
        {
            await LoadAsync();
        }

        UpdatePolling();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Nur solange ein Auftrag wartet oder läuft, alle 3 s nachladen.</summary>
    private void UpdatePolling()
    {
        if (_disposed)
        {
            return;
        }

        if (CurrentJob is not null && _pollTimer is null)
        {
            _pollTimer = new System.Threading.Timer(_ => _ = InvokeAsync(LoadJobsAsync), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        else if (CurrentJob is null && _pollTimer is not null)
        {
            _pollTimer.Dispose();
            _pollTimer = null;
        }
    }

    private async Task StartJobAsync()
    {
        _starting = true;
        _message = null;

        try
        {
            var model = new CreateDartBotTrainingJobModel
            {
                Preset = Enum.TryParse<DartBotTrainingJobPresetEnum>(_preset, out var preset) ? preset : DartBotTrainingJobPresetEnum.Quick
            };

            using var response = await Api.PostAsync("DartBotTrainingJobAdministration/CreateDartBotTrainingJob", model);

            if (response.IsSuccessStatusCode)
            {
                ShowMessage("Training gestartet. Der Fortschritt aktualisiert sich automatisch.", isError: false);
            }
            else
            {
                ShowMessage(await ApiProblem.ReadMessageAsync(response), isError: true);
            }
        }
        catch
        {
            ShowMessage("Das Training konnte nicht gestartet werden.", isError: true);
        }

        _starting = false;
        await LoadJobsAsync();
    }

    private async Task CancelJobAsync()
    {
        if (CurrentJob is null)
        {
            return;
        }

        _cancelling = true;

        try
        {
            using var response = await Api.PostAsync($"DartBotTrainingJobAdministration/CancelDartBotTrainingJob?jobId={CurrentJob.Id}");

            if (!response.IsSuccessStatusCode)
            {
                ShowMessage(await ApiProblem.ReadMessageAsync(response), isError: true);
            }
        }
        catch
        {
            ShowMessage("Der Auftrag konnte nicht abgebrochen werden.", isError: true);
        }

        _cancelling = false;
        await LoadJobsAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _pollTimer?.Dispose();
    }

    private static string PresetText(DartBotTrainingJobPresetEnum preset) =>
        preset == DartBotTrainingJobPresetEnum.Standard ? "Standard" : "Schnell";

    private static int PhaseNumber(DartBotTrainingJobPhaseEnum phase) => (int)phase;

    private static string PhaseText(DartBotTrainingJobPhaseEnum phase) => phase switch
    {
        DartBotTrainingJobPhaseEnum.Generate => "Datensatz erzeugen",
        DartBotTrainingJobPhaseEnum.Train => "Modell trainieren",
        _ => "Vergleich gegen Regelwerk"
    };

    private static string JobStatusText(DartBotTrainingJobListItem job) => job.Status switch
    {
        DartBotTrainingJobStatusEnum.Queued => "Wartet",
        DartBotTrainingJobStatusEnum.Running => job.CancelRequested ? "Wird abgebrochen" : $"Läuft · {job.ProgressPercent} %",
        DartBotTrainingJobStatusEnum.Completed => "Fertig",
        DartBotTrainingJobStatusEnum.Cancelled => "Abgebrochen",
        _ => "Fehlgeschlagen"
    };

    private static AdminStatus JobStatus(DartBotTrainingJobListItem job) => job.Status switch
    {
        DartBotTrainingJobStatusEnum.Completed => AdminStatus.Success,
        DartBotTrainingJobStatusEnum.Failed => AdminStatus.Danger,
        DartBotTrainingJobStatusEnum.Running or DartBotTrainingJobStatusEnum.Queued => AdminStatus.Warning,
        _ => AdminStatus.Neutral
    };

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalHours >= 1 ? $"{(int)duration.TotalHours} h {duration.Minutes} min" : $"{Math.Max(1, (int)Math.Round(duration.TotalMinutes))} min";

    /// <summary>Vergleichszeilen zur Schwelle der API; ohne passende Schwelle die nächstgelegene.</summary>
    private List<DartBotModelComparisonLevel> LevelsFor(DartBotModelListItem model)
    {
        if (model.Comparison.Count == 0 || _overview is null)
        {
            return [];
        }

        var margin = model.Comparison
            .Select(l => l.Margin)
            .Distinct()
            .OrderBy(m => Math.Abs(m - _overview.Margin))
            .First();

        return model.Comparison.Where(l => l.Margin == margin).OrderBy(l => l.Skill).ToList();
    }

    // Intervall ganz unter 0 = signifikant besser, ganz über 0 = signifikant schlechter.
    private static string VerdictText(DartBotModelComparisonLevel level) =>
        level.Ci95High < 0 ? "besser" : level.Ci95Low > 0 ? "schlechter" : "gleich";

    private static AdminStatus VerdictStatus(DartBotModelComparisonLevel level) =>
        level.Ci95High < 0 ? AdminStatus.Success : level.Ci95Low > 0 ? AdminStatus.Danger : AdminStatus.Neutral;

    private static string FileText(DartBotModelFileStatusEnum status) => status switch
    {
        DartBotModelFileStatusEnum.Ok => "Geprüft",
        DartBotModelFileStatusEnum.ShaMismatch => "Verändert",
        DartBotModelFileStatusEnum.SchemaMismatch => "Altes Schema",
        _ => "Fehlt"
    };

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{bytes / 1024d:0} KB";

    private void ShowMessage(string text, bool isError)
    {
        _message = text;
        _messageIsError = isError;
    }
}
