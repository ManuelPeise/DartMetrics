@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

@*
    Eigenständiges Layout für /admin (Interactive Server).
    Wird nur für die Rolle Admin gerendert. Der Seitenschutz selbst kommt zusätzlich über
    [Authorize(Roles = "Admin")] (Pages/Admin/_Imports.razor) und AuthorizeRouteView; die API prüft serverseitig.
*@
<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="adm-shell @ShellClass">
            <AdminSidebar Collapsed="_collapsed"
                          OnToggleCollapse="ToggleCollapse"
                          OnNavigate="CloseDrawer"
                          UserEmail="@GetEmail(context.User)" />

            <button type="button" class="adm-backdrop" aria-label="Menü schließen" @onclick="CloseDrawer"></button>

            <div class="adm-main">
                <AdminHeader OnOpenMenu="OpenDrawer" UserEmail="@GetEmail(context.User)" />

                <main class="adm-content" id="admin-content">
                    @if (MustChangePassword(context.User))
                    {
                        @* Einmal-Passwort: nur die Passwort-Änderung, keine anderen Seiten. *@
                        <Web.App.Components.Pages.Admin.AdminPassword Forced="true" />
                    }
                    else
                    {
                        @Body
                    }
                </main>
            </div>

            <AdminBottomNav OnMore="OpenDrawer" />
        </div>
    </Authorized>
    <NotAuthorized>
        @if (context.User.Identity?.IsAuthenticated == true)
        {
            <AdminAccessDenied />
        }
        else
        {
            <Web.App.Client.Pages.Shared.RedirectToLogin IsAuthenticated="false" />
        }
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static bool MustChangePassword(System.Security.Claims.ClaimsPrincipal user) =>
        user.HasClaim(Web.Shared.Constants.BlazorClaimTypes.MustChangePassword, "true");

    private bool _collapsed;
    private bool _drawerOpen;

    private string ShellClass =>
        (_collapsed ? "adm-shell--collapsed " : "") + (_drawerOpen ? "adm-shell--drawer-open" : "");

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void ToggleCollapse() => _collapsed = !_collapsed;

    private void OpenDrawer() => _drawerOpen = true;

    private void CloseDrawer() => _drawerOpen = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_drawerOpen)
        {
            _drawerOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private static string GetEmail(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? "Administrator";

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
