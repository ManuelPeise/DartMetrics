@* Hinweis während der Design-Phase: die Seite zeigt Beispieldaten, Aktionen wirken nur lokal. *@
<div class="adm-preview-note" role="note">
    <AdminIcon Name="AdminIconName.Alert" Size="16" />
    <span>@Text</span>
</div>

@code {
    [Parameter] public string Text { get; set; } = "Vorschau mit Beispieldaten – Aktionen werden nicht gespeichert.";
}
