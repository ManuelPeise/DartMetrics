<div class="adm-field @(string.IsNullOrEmpty(Error) ? "" : "adm-field--error")">
    <label class="adm-field__label" for="@Id">@Label</label>
    <select id="@Id" class="adm-select" value="@Value" disabled="@Disabled" @onchange="OnChangeAsync">
        @foreach (var option in Options)
        {
            <option value="@option.Value" selected="@(option.Value == Value)">@option.Text</option>
        }
    </select>
    @if (!string.IsNullOrEmpty(Error))
    {
        <span class="adm-field__error">@Error</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="adm-field__hint">@Hint</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public IReadOnlyList<AdminSelectOption> Options { get; set; } = [];

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
