@* Einfache Linien-Icons als Inline-SVG (keine Icon-Bibliothek, kein JavaScript). *@
<svg class="adm-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case AdminIconName.Dashboard:
            <rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" />
            <rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" />
            break;
        case AdminIconName.Users:
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5" />
            <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.9.7 3.1 2.4 3.5 5.2" />
            break;
        case AdminIconName.UserCheck:
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5 1.4 0 2.7.4 3.8 1.1" />
            <path d="m15.5 18 2 2 4-4.5" />
            break;
        case AdminIconName.Bot:
            <rect x="4" y="8" width="16" height="12" rx="3" /><path d="M12 4v4M9 13h.01M15 13h.01M9.5 17h5" />
            <circle cx="12" cy="3.5" r="1" />
            break;
        case AdminIconName.Model:
            <rect x="6" y="6" width="12" height="12" rx="2" /><rect x="9.5" y="9.5" width="5" height="5" rx="1" />
            <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
            break;
        case AdminIconName.Chart:
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
            break;
        case AdminIconName.Logs:
            <path d="M8 6h12M8 12h12M8 18h12" /><path d="M4 6h.01M4 12h.01M4 18h.01" />
            break;
        case AdminIconName.Settings:
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            break;
        case AdminIconName.Training:
            <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" />
            break;
        case AdminIconName.Pulse:
            <path d="M3 12h4l2.5-6 5 12 2.5-6h4" />
            break;
        case AdminIconName.Server:
            <rect x="3" y="4" width="18" height="7" rx="2" /><rect x="3" y="13" width="18" height="7" rx="2" />
            <path d="M7 7.5h.01M7 16.5h.01" />
            break;
        case AdminIconName.Database:
            <ellipse cx="12" cy="5.5" rx="8" ry="3" /><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
            break;
        case AdminIconName.Process:
            <path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" />
            break;
        case AdminIconName.Bell:
            <path d="M6 9a6 6 0 1 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9" /><path d="M10 20a2 2 0 0 0 4 0" />
            break;
        case AdminIconName.Menu:
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case AdminIconName.More:
            <circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" />
            break;
        case AdminIconName.ChevronLeft:
            <path d="m15 6-6 6 6 6" />
            break;
        case AdminIconName.ChevronRight:
            <path d="m9 6 6 6-6 6" />
            break;
        case AdminIconName.Logout:
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="M10 17l-5-5 5-5M5 12h11" />
            break;
        case AdminIconName.Home:
            <path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v10h13V10" />
            break;
        case AdminIconName.Lock:
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case AdminIconName.Alert:
            <path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4M12 17h.01" />
            break;
        case AdminIconName.Inbox:
            <path d="M3 13h5l1.5 3h5l1.5-3h5" /><path d="M5 5h14l2 8v6H3v-6l2-8z" />
            break;
        case AdminIconName.Close:
            <path d="M6 6l12 12M18 6 6 18" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public AdminIconName Name { get; set; }

    [Parameter] public int Size { get; set; } = 20;

    [Parameter] public string? Class { get; set; }
}
