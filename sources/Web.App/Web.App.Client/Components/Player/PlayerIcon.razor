@* Linien-Icons als Inline-SVG für den Spieler-Bereich (keine Icon-Bibliothek). *@
<svg class="pa-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case PlayerIconName.Home:
            <path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v10h13V10" />
            break;
        case PlayerIconName.Training:
            <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" />
            break;
        case PlayerIconName.Bot:
            <rect x="4" y="8" width="16" height="12" rx="3" /><path d="M12 4v4M9 13h.01M15 13h.01M9.5 17h5" /><circle cx="12" cy="3.5" r="1" />
            break;
        case PlayerIconName.Chart:
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
            break;
        case PlayerIconName.User:
            <circle cx="12" cy="8" r="4" /><path d="M4 21c1-4.2 4.2-6.5 8-6.5s7 2.3 8 6.5" />
            break;
        case PlayerIconName.Logout:
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="M10 17l-5-5 5-5M5 12h11" />
            break;
        case PlayerIconName.Play:
            <path d="M7 4.5v15l12-7.5-12-7.5z" />
            break;
        case PlayerIconName.Alert:
            <path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4M12 17h.01" />
            break;
        case PlayerIconName.Inbox:
            <path d="M3 13h5l1.5 3h5l1.5-3h5" /><path d="M5 5h14l2 8v6H3v-6l2-8z" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public PlayerIconName Name { get; set; }

    [Parameter] public int Size { get; set; } = 20;

    [Parameter] public string? Class { get; set; }
}
