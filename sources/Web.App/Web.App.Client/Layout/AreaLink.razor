@using Web.App.Client.Routing
@inject NavigationManager Navigation

@* Link that does a full page load when it crosses the border between the WebAssembly and the Server area (admin, static pages). *@
<a href="@Href" class="@Class" data-enhance-nav="false" @onclick="NavigateAsync" @onclick:preventDefault="@RendererInfo.IsInteractive">@ChildContent</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void NavigateAsync()
    {
        var currentlyOnServer = RendererInfo.Name == "Server";
        var forceLoad = currentlyOnServer || AppAreas.RequiresFullPageLoad(Href);

        Navigation.NavigateTo(Href, forceLoad);
    }
}
