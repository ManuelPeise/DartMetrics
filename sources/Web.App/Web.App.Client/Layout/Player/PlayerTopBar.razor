@implements IDisposable
@inject PlayerProfileState _profile

<header class="pa-topbar">
    <a href="@PlayerNavigation.Root" class="pa-brand" title="DartMetrics">
        <img src="img/dart_board.png" alt="" width="32" height="32" />
        <span>Dart<span class="pa-brand-accent">Metrics</span></span>
    </a>

    <nav class="pa-nav" aria-label="Hauptnavigation">
        @foreach (var item in PlayerNavigation.Items)
        {
            <NavLink href="@item.Href" class="pa-nav-link" title="@item.Title"
                     Match="@(item.MatchExact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <PlayerIcon Name="item.Icon" Size="18" />
                <span class="pa-nav-link__label">@item.Title</span>
            </NavLink>
        }
    </nav>

    <AuthorizeView>
        <div class="pa-user">
            <span class="pa-user__name">@context.User.Identity?.Name</span>
            <a href="player/profile" class="pa-user__avatar" title="Profil">
                <PlayerAvatar FirstName="@_profile.Profile?.FirstName" LastName="@_profile.Profile?.LastName"
                              Name="@context.User.Identity?.Name" AvatarVersion="@_profile.Profile?.AvatarVersion" Decorative="true" />
                <span class="pa-sr-only">Profil</span>
            </a>
            <AreaLink Href="/logout" Class="pa-icon-btn">
                <PlayerIcon Name="PlayerIconName.Logout" />
                <span class="pa-sr-only">Abmelden</span>
            </AreaLink>
        </div>
    </AuthorizeView>
</header>

@code {
    protected override async Task OnInitializedAsync()
    {
        _profile.Changed += HandleChanged;
        await _profile.EnsureLoadedAsync();
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => _profile.Changed -= HandleChanged;
}
