@page "/password/reset"
@layout PublicLayout
@using global::Shared.Models.Authentication
@inject IAccountService AccountService

@* Ziel des Links in der Reset-Mail: /password/reset?token=... *@

<PageTitle>Neues Passwort – DartMetrics</PageTitle>

<section class="pl-card" aria-labelledby="reset-title" aria-live="polite">
    @if (_done)
    {
        <p class="pl-eyebrow">Alles erledigt</p>
        <h1 id="reset-title" class="pl-title">Passwort <em>geändert</em></h1>
        <p class="pl-alert pl-alert--success" role="status">Dein neues Passwort gilt ab sofort. Du wurdest überall abgemeldet.</p>
        <div class="pl-actions pl-actions--spaced">
            <a href="login" class="pl-btn pl-btn--primary pl-btn--block">Zur Anmeldung</a>
        </div>
    }
    else if (_invalid || string.IsNullOrWhiteSpace(Token))
    {
        <p class="pl-eyebrow">Zurücksetzen fehlgeschlagen</p>
        <h1 id="reset-title" class="pl-title">Link ungültig</h1>
        <p class="pl-alert" role="alert">Der Link ist ungültig, abgelaufen (60 Minuten) oder wurde schon verwendet.</p>
        <div class="pl-actions pl-actions--spaced">
            <a href="password/forgot" class="pl-btn pl-btn--primary">Neuen Link anfordern</a>
            <a href="login" class="pl-btn pl-btn--ghost">Zur Anmeldung</a>
        </div>
    }
    else
    {
        <p class="pl-eyebrow">Fast geschafft</p>
        <h1 id="reset-title" class="pl-title">Neues Passwort</h1>

        <form class="pl-form" @onsubmit="ResetAsync" @onsubmit:preventDefault>
            @if (_error is not null)
            {
                <p class="pl-alert" role="alert">@_error</p>
            }

            <div class="pl-field">
                <label for="password">Neues Passwort <span class="pl-optional">@PasswordPolicy.Description</span></label>
                <input id="password" type="password" class="pl-input" autocomplete="new-password" @bind="_password" />
            </div>
            <div class="pl-field">
                <label for="repeat">Neues Passwort wiederholen</label>
                <input id="repeat" type="password" class="pl-input" autocomplete="new-password" @bind="_repeat" />
            </div>

            <button type="submit" class="pl-btn pl-btn--primary pl-btn--block" disabled="@_busy">@(_busy ? "Speichert …" : "Passwort speichern")</button>
        </form>
    }
</section>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string? _password;
    private string? _repeat;
    private string? _error;
    private bool _busy;
    private bool _done;
    private bool _invalid;

    private async Task ResetAsync()
    {
        _error = null;

        if (string.IsNullOrEmpty(_password) || _password.Length < PasswordPolicy.MinLength || System.Text.Encoding.UTF8.GetByteCount(_password) > PasswordPolicy.MaxLength)
        {
            _error = $"Das Passwort braucht {PasswordPolicy.MinLength} bis {PasswordPolicy.MaxLength} Zeichen.";
            return;
        }

        if (_password != _repeat)
        {
            _error = "Die Passwörter stimmen nicht überein.";
            return;
        }

        _busy = true;

        try
        {
            if (await AccountService.ResetPasswordAsync(Token!, _password, _repeat))
            {
                _done = true;
            }
            else
            {
                _invalid = true;
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _error = "Zu viele Versuche. Bitte warte eine Minute und versuche es dann erneut.";
        }
        catch (HttpRequestException)
        {
            _error = "Der Server ist nicht erreichbar. Bitte später erneut versuchen.";
        }
        finally
        {
            _busy = false;
        }
    }
}
