@page "/password/forgot"
@layout PublicLayout
@inject IAccountService AccountService

<PageTitle>Passwort vergessen – DartMetrics</PageTitle>

<section class="pl-card" aria-labelledby="forgot-title" aria-live="polite">
    <p class="pl-eyebrow">Kein Problem</p>
    <h1 id="forgot-title" class="pl-title">Passwort vergessen</h1>

    @if (_sent)
    {
        <p class="pl-alert pl-alert--success" role="status">
            Falls es zu <strong>@_email</strong> ein aktives Konto gibt, haben wir dir einen Link geschickt.
            Er ist 60 Minuten gültig und lässt sich einmal verwenden.
        </p>
        <div class="pl-actions pl-actions--spaced">
            <a href="login" class="pl-btn pl-btn--primary">Zur Anmeldung</a>
        </div>
    }
    else
    {
        <p class="pl-lead">Gib deine E-Mail-Adresse ein. Wir schicken dir einen Link, mit dem du ein neues Passwort setzen kannst.</p>

        <form class="pl-form" @onsubmit="SendAsync" @onsubmit:preventDefault>
            @if (_error is not null)
            {
                <p class="pl-alert" role="alert">@_error</p>
            }

            <div class="pl-field">
                <label for="email">E-Mail</label>
                <input id="email" type="email" class="pl-input" autocomplete="username" placeholder="name@beispiel.de" @bind="_email" />
            </div>

            <button type="submit" class="pl-btn pl-btn--primary pl-btn--block" disabled="@_busy">@(_busy ? "Sendet …" : "Link senden")</button>
        </form>

        <p class="pl-switch"><a href="login">Zurück zur Anmeldung</a></p>
    }
</section>

@code {
    private string? _email;
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task SendAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(_email))
        {
            _error = "Bitte eine gültige E-Mail-Adresse eingeben.";
            return;
        }

        _busy = true;

        try
        {
            if (await AccountService.ForgotPasswordAsync(_email.Trim()))
            {
                _sent = true;
            }
            else
            {
                _error = "Bitte eine gültige E-Mail-Adresse eingeben.";
            }
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _error = "Zu viele Versuche. Bitte warte eine Minute und versuche es dann erneut.";
        }
        catch (HttpRequestException)
        {
            _error = "Der Server ist nicht erreichbar. Bitte später erneut versuchen.";
        }
        finally
        {
            _busy = false;
        }
    }
}
