@page "/login"
@layout PublicLayout
@using Web.App.Client.Routing
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Anmelden – DartMetrics</PageTitle>

<section class="pl-card" aria-labelledby="login-title">
    <p class="pl-eyebrow">Willkommen zurück</p>
    <h1 id="login-title" class="pl-title">Anmelden</h1>
    <p class="pl-lead">Melde dich an, um deine Spiele und Statistiken zu sehen.</p>

    <EditForm Model="_model" OnValidSubmit="LoginAsync" FormName="login" class="pl-form">
        <DataAnnotationsValidator />

        @if (_error != null)
        {
            <p class="pl-alert" role="alert">@_error</p>
        }

        <div class="pl-field">
            <label for="email">E-Mail</label>
            <InputText id="email" type="email" class="pl-input" autocomplete="username"
                       placeholder="name@beispiel.de" @bind-Value="_model.EmailAddress" />
            <ValidationMessage For="() => _model.EmailAddress" />
        </div>

        <div class="pl-field">
            <label for="password">Passwort</label>
            <InputText id="password" type="password" class="pl-input" autocomplete="current-password"
                       @bind-Value="_model.Password" />
            <ValidationMessage For="() => _model.Password" />
        </div>

        <button type="submit" class="pl-btn pl-btn--primary pl-btn--block" disabled="@_busy">
            @(_busy ? "Anmelden …" : "Anmelden")
        </button>
    </EditForm>

    @if (_resendMessage is not null)
    {
        <p class="pl-alert pl-alert--success" role="status">@_resendMessage</p>
    }
    else if (_loginFailed)
    {
        <p class="pl-switch">
            Konto noch nicht bestätigt?
            <button type="button" class="pl-btn pl-btn--link" disabled="@_busy" @onclick="ResendAsync">Bestätigungsmail erneut senden</button>
        </p>
    }

    <p class="pl-switch"><a href="password/forgot">Passwort vergessen?</a></p>

    <p class="pl-switch">Noch kein Konto? <a href="register">Jetzt registrieren</a></p>
</section>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;
    private bool _loginFailed;
    private string? _resendMessage;

    private async Task ResendAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.EmailAddress))
        {
            _error = "Bitte zuerst deine E-Mail-Adresse eingeben.";
            return;
        }

        _busy = true;

        try
        {
            await AccountService.ResendVerificationAsync(_model.EmailAddress.Trim());
            _resendMessage = "Falls es zu dieser Adresse ein unbestätigtes Konto gibt, ist eine neue Bestätigungsmail unterwegs.";
        }
        catch (HttpRequestException)
        {
            _error = "Der Server ist nicht erreichbar. Bitte später erneut versuchen.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoginAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            if (!await AccountService.LoginAsync(_model))
            {
                _error = "E-Mail oder Passwort ist falsch – oder das Konto ist noch nicht bestätigt.";
                _loginFailed = true;
                return;
            }

            var target = await GetTargetAsync();

            Navigation.NavigateTo(target, forceLoad: AppAreas.IsServerArea(target));
        }
        catch (HttpRequestException)
        {
            _error = "Der Server ist nicht erreichbar. Bitte später erneut versuchen.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Ziel nach dem Login: Admins landen immer im Admin-Bereich (eine angeforderte Admin-Seite bleibt erhalten),
    /// Player und GameMaster auf der angeforderten Seite bzw. im Spieler-Bereich.
    /// </summary>
    private async Task<string> GetTargetAsync()
    {
        var returnUrl = AppAreas.SafeReturnUrl(ReturnUrl);

        // Nach LoginAsync ist der Anmeldestatus bereits neu geladen (Refresh im AccountService).
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (state.User.IsInRole("Admin"))
        {
            return AppAreas.IsServerArea(returnUrl) ? returnUrl : AppAreas.AdminPath;
        }

        // Ohne gezielt angeforderte Seite in den Spieler-Bereich statt auf die öffentliche Startseite.
        return returnUrl == "/" ? PlayerNavigation.Root : returnUrl;
    }
}
