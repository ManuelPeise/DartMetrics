@page "/remote"
@layout RemoteLayout
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using global::Shared.Enums.Remote
@using global::Shared.Models.Remote
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

@*
    Handy als Eingabegerät, ohne Anmeldung: Der QR-Code der Spielseite öffnet /remote?code=…,
    der einmalige Code wird gegen einen Geräte-Token getauscht (nur in diesem Tab gespeichert).
    Die Seite kennt keine Spielregeln: Sie zeigt den Zustand der Spielseite und schickt Tasten.
*@

<PageTitle>DartMetrics – Eingabe</PageTitle>

@switch (_phase)
{
    case Phase.Pairing:
        <PlayerLoadingState />
        break;

    case Phase.NotPaired:
        <div class="pa-remote-app__message">
            <h1 class="pl-title">Nicht verbunden</h1>
            <p class="pl-lead">@(_message ?? "Öffne im Browser eine Spielseite, tippe auf „Handy verbinden“ und scanne den QR-Code mit der Kamera.")</p>
        </div>
        break;

    case Phase.Connected:
        <div class="pa-remote-app__screen">
            @if (_state is null)
            {
                <div class="pa-remote-app__message">
                    <h1 class="pl-title">Verbunden</h1>
                    <p class="pl-lead">@(_waitingText)</p>
                </div>
            }
            else
            {
                <header class="pa-remote-app__head">
                    <p class="pa-remote-app__title">@_state.Title</p>
                    @if (!string.IsNullOrEmpty(_state.Subtitle))
                    {
                        <p class="pa-remote-app__subtitle">@_state.Subtitle</p>
                    }
                </header>

                <div class="pa-remote-app__players">
                    @foreach (var player in _state.Players)
                    {
                        <div class="pa-duel__player @(player.IsActive ? "is-active" : "")">
                            <p class="pa-duel__name">@player.Name</p>
                            <p class="pa-duel__score">@player.Value</p>
                            @if (!string.IsNullOrEmpty(player.Detail))
                            {
                                <p class="pa-duel__meta">@player.Detail</p>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_state.Checkout))
                {
                    <p class="pa-checkout-hint"><span>Checkout</span> <strong>@_state.Checkout</strong></p>
                }

                @if (!string.IsNullOrEmpty(_state.Status))
                {
                    <p class="pa-remote-app__status @(string.IsNullOrEmpty(_state.StatusTone) ? "" : $"is-{_state.StatusTone}")" aria-live="polite">@_state.Status</p>
                }

                @if (!_state.IsFinished)
                {
                    <DartInputPad CurrentDarts="Darts" OnDart="SendDartAsync" OnUndo="UndoAsync" CanUndo="_state.CanUndo"
                                  OnSubmit="SubmitAsync" CanSubmit="_state.CanSubmit" InputLocked="_state.InputLocked"
                                  SubmitHint="@_state.Hint" SubmitHintTone="@_state.HintTone"
                                  Disabled="@(!_state.CanInput || !IsOnline)" />
                }
            }

            @if (!IsOnline)
            {
                <p class="pl-alert" role="alert">Verbindung unterbrochen – wird wiederhergestellt …</p>
            }
        </div>
        break;
}

@code {
    private const string ExpiredText = "Die Kopplung ist abgelaufen oder du wurdest im Browser abgemeldet. Bitte den QR-Code neu scannen.";

    private enum Phase { Pairing, NotPaired, Connected }

    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }

    private Phase _phase = Phase.Pairing;
    private string? _message;
    private string _waitingText = "Warte auf die Spielseite im Browser …";
    private HubConnection? _connection;
    private RemoteDisplayState? _state;
    private bool _disposed;
    private bool _retried;

    private bool IsOnline => _connection?.State == HubConnectionState.Connected;

    private IReadOnlyList<DartThrowInput> Darts =>
        _state?.Darts.Select(d => new DartThrowInput(d.Segment, d.Multiplier)).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        var token = string.IsNullOrEmpty(Code) ? await GetStoredTokenAsync() : await PairAsync(Code);

        // Code nicht in der Adresszeile (Verlauf) stehen lassen.
        if (!string.IsNullOrEmpty(Code))
        {
            Navigation.NavigateTo("/remote", replace: true);
        }

        if (token is null)
        {
            _phase = Phase.NotPaired;
            return;
        }

        await ConnectAsync(token);
    }

    private async Task<string?> PairAsync(string code)
    {
        try
        {
            var client = HttpClientFactory.CreateClient(BffHttpClient.Name);
            using var response = await client.PostAsJsonAsync("remote/pair", new RemotePairRequest { Code = code, DeviceName = "Handy" });

            if (!response.IsSuccessStatusCode)
            {
                _message = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                    ? "Zu viele Versuche – bitte kurz warten und neu scannen."
                    : "Der QR-Code ist abgelaufen oder wurde schon benutzt. Bitte im Browser einen neuen anzeigen lassen.";
                return null;
            }

            var paired = await response.Content.ReadFromJsonAsync<RemotePairResponse>();
            await JS.InvokeVoidAsync("dartRemote.setToken", paired?.DeviceToken);
            return paired?.DeviceToken;
        }
        catch (HttpRequestException)
        {
            _message = "Der Server ist nicht erreichbar.";
            return null;
        }
    }

    private async Task<string?> GetStoredTokenAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("dartRemote.getToken");
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task ConnectAsync(string token)
    {
        _connection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri(RemoteHubMethods.HubPath), options => options.AccessTokenProvider = () => Task.FromResult<string?>(token))
            .WithAutomaticReconnect()
            .Build();

        _connection.On<RemoteDisplayState>(RemoteHubMethods.State, state => InvokeAsync(() =>
        {
            _state = state;
            StateHasChanged();
        }));

        _connection.On(RemoteHubMethods.DisplayGone, () => InvokeAsync(() =>
        {
            _state = null;
            _waitingText = "Keine Spielseite offen. Öffne im Browser ein Training oder Spiel – die Eingabe erscheint dann hier.";
            StateHasChanged();
        }));

        _connection.Reconnecting += _ => InvokeAsync(StateHasChanged);
        _connection.Reconnected += async _ =>
        {
            await _connection.InvokeAsync(RemoteHubMethods.RegisterController);
            await InvokeAsync(StateHasChanged);
        };
        _connection.Closed += _ => InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            // Automatisches Wiederverbinden aufgegeben: einmal neu aufbauen; klappt das nicht, ist die Kopplung vorbei
            // (Token abgelaufen, Abmeldung im Browser).
            if (!_retried)
            {
                _retried = true;
                var old = _connection;
                await ConnectAsync(token);
                if (old is not null && !ReferenceEquals(old, _connection))
                {
                    await old.DisposeAsync();
                }
                return;
            }

            await ForgetAsync(ExpiredText);
        });

        try
        {
            await _connection.StartAsync();
            await _connection.InvokeAsync(RemoteHubMethods.RegisterController);
            _phase = Phase.Connected;
            _retried = false;
            await JS.InvokeVoidAsync("dartRemote.keepAwake");
        }
        catch (Exception)
        {
            await ForgetAsync(ExpiredText);
        }
    }

    private async Task ForgetAsync(string message)
    {
        if (_disposed)
        {
            return;
        }

        _message = message;
        _state = null;
        _phase = Phase.NotPaired;

        try
        {
            await JS.InvokeVoidAsync("dartRemote.setToken", (string?)null);
            await JS.InvokeVoidAsync("dartRemote.release");
        }
        catch (JSException)
        {
        }

        StateHasChanged();
    }

    private Task SendDartAsync(DartThrowInput dart) =>
        SendAsync(new RemoteCommand { Type = RemoteCommandTypeEnum.Dart, Segment = dart.Segment, Multiplier = dart.Multiplier });

    private Task UndoAsync() => SendAsync(new RemoteCommand { Type = RemoteCommandTypeEnum.Undo });

    private async Task SubmitAsync()
    {
        await SendAsync(new RemoteCommand { Type = RemoteCommandTypeEnum.Submit });
        await JS.InvokeVoidAsync("dartRemote.vibrate", 40);
    }

    private async Task SendAsync(RemoteCommand command)
    {
        if (!IsOnline)
        {
            return;
        }

        try
        {
            await _connection!.InvokeAsync(RemoteHubMethods.SendCommand, command);
        }
        catch (Exception)
        {
            // Verbindung weg: Hinweis erscheint über IsOnline, Reconnect läuft automatisch.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_connection is not null)
        {
            await _connection.DisposeAsync();
        }

        try
        {
            await JS.InvokeVoidAsync("dartRemote.release");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
