@page "/player/bots"
@using global::Shared.Enums.Bot
@using global::Shared.Enums.X01
@using global::Shared.Models.Bot
@using global::Shared.Models.Remote
@using global::Shared.Models.Shared
@inject IBotGameApi BotGameApi
@inject IProfileApi ProfileApi
@inject PlayerProfileState Profile

<PageTitle>Gegen Bot spielen – DartMetrics</PageTitle>

<PlayerPageHeader Eyebrow="Spielen" Title="@HeaderTitle" Subtitle="@HeaderSubtitle">
    <Actions>
        @if (_phase == Phase.Playing && _state is not null)
        {
            @if (_confirmAbort)
            {
                <button type="button" class="pl-btn pl-btn--ghost" disabled="@_busy" @onclick="AbortAsync">Wirklich abbrechen?</button>
                <button type="button" class="pl-btn pl-btn--link" @onclick="() => _confirmAbort = false">Weiterspielen</button>
            }
            else
            {
                <button type="button" class="pl-btn pl-btn--link" @onclick="() => _confirmAbort = true">Spiel abbrechen</button>
            }
        }
    </Actions>
</PlayerPageHeader>

@if (_error is not null)
{
    <PlayerErrorState Text="@_error" />
}

@switch (_phase)
{
    case Phase.Loading:
        <PlayerLoadingState />
        break;

    case Phase.Setup:
        <div class="pa-setup" style="max-width: 760px">
            @if (_bots is null || _bots.Count == 0)
            {
                <PlayerEmptyState Icon="PlayerIconName.Bot" Title="Noch keine Gegner"
                                  Text="Sobald ein Administrator Bots anlegt, kannst du hier gegen sie antreten." />
            }
            else
            {
                <fieldset class="pa-choice">
                    <legend class="pa-choice__label">Gegner@(_userRating is { } rating ? $" · dein Elo {rating}" : "")</legend>
                    <div class="pa-bot-list">
                        @foreach (var bot in _bots)
                        {
                            <button type="button" class="pa-bot-option @(bot.Id == _botId ? "is-selected" : "")"
                                    aria-pressed="@(bot.Id == _botId ? "true" : "false")" @onclick="() => SelectBotAsync(bot.Id)">
                                <PlayerIcon Name="PlayerIconName.Bot" Size="22" />
                                <span>
                                    <strong>@bot.Name</strong>
                                    <small>@(bot.StageName is null ? $"Level {bot.DevelopmentLevel}" : $"{bot.StageName} · Ø {bot.BaseAverage:0}") · Elo @bot.Rating</small>
                                    @if (EloMatch.IsGoodMatch(_userRating, bot.Rating))
                                    {
                                        <small class="pa-bot-option__match">Passender Gegner</small>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </fieldset>

                @if (_card is not null && _card.Id == _botId)
                {
                    <BotProfileCardView Card="_card" />
                }

                <PlayerChoiceGroup Label="Art" Options="ModeOptions" @bind-Value="_gameMode" />
                @if (_gameMode == DartBotGameModeEnum.Match)
                {
                    <PlayerChoiceGroup Label="Satz (Best of Legs)" Options="BestOfOptions" @bind-Value="_bestOfLegs" />
                }
                else
                {
                    <p class="pa-section__hint">Training: ein Satz Best of @X01SetRules.TrainingBestOfLegs (First to @X01SetRules.LegsToWin(X01SetRules.TrainingBestOfLegs)).</p>
                }
                <PlayerChoiceGroup Label="Startwert" Options="ScoreOptions" @bind-Value="_startingScore" />
                <PlayerChoiceGroup Label="Anwurf im ersten Leg" Options="StarterOptions" @bind-Value="_userStarts" />
                <PlayerChoiceGroup Label="Eröffnen" Options="InOptions" @bind-Value="_inMode" />
                <PlayerChoiceGroup Label="Beenden" Options="OutOptions" @bind-Value="_outMode" />

                <div class="pa-setup__actions">
                    <button type="button" class="pl-btn pl-btn--primary" disabled="@(_busy || _botId is null)" @onclick="StartAsync">
                        @(_busy ? "Startet …" : "Spiel starten")
                    </button>
                </div>
            }
        </div>
        break;

    case Phase.Playing when _state is not null:
        <div class="pa-play">
            <div class="pa-play__info">
                <div class="pa-duel">
                    <div class="pa-duel__player @(IsUserActive ? "is-active" : "")">
                        <p class="pa-duel__name">Du</p>
                        <p class="pa-duel__score">@DisplayUserRemaining</p>
                        <p class="pa-duel__meta">@(_state.IsUserOpened ? $"Ø {UserAverage}" : "noch nicht eröffnet")</p>
                        @if (IsUserActive)
                        {
                            <CheckoutHint Suggestions="UserCheckout" />
                        }
                    </div>
                    <div class="pa-duel__legs">
                        Legs
                        <strong>@(_shown?.UserLegs ?? _state.UserLegsWon) : @(_shown?.BotLegs ?? _state.BotLegsWon)</strong>
                        Leg @(_shown?.LegNumber ?? _state.CurrentLegNumber)
                    </div>
                    <div class="pa-duel__player @(_animating ? "is-active" : "")">
                        <p class="pa-duel__name">@_state.BotName</p>
                        <p class="pa-duel__score">@(_shown?.BotRemaining ?? _state.BotRemaining)</p>
                        <p class="pa-duel__meta">@(_state.IsBotOpened ? "Bot" : "noch nicht eröffnet")</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_status))
                {
                    <PlayerScoreboard Label="Spielstand" Value="@StatusValue" Status="@_status" Tone="@_tone" />
                }

                @if (_botDarts.Count > 0)
                {
                    <div class="pa-bot-visit" aria-live="polite">
                        <span>@_state.BotName wirft:</span>
                        @foreach (var dart in _botDarts)
                        {
                            <span class="pa-bot-dart" title="@($"Ziel: {TargetLabel(dart)}")">
                                <strong>@(new DartThrowInput(dart.Segment, dart.Multiplier).Label)</strong>
                                <small>Ziel @TargetLabel(dart)</small>
                            </span>
                        }
                        @if (_botVisitResult is not null)
                        {
                            <span>@_botVisitResult</span>
                        }
                    </div>
                }
            </div>

            <div>
                <DartInputPad CurrentDarts="_darts" OnDart="AddDart" OnUndo="UndoDart" CanUndo="@(_darts.Count > 0)"
                              OnSubmit="SubmitVisitAsync" CanSubmit="@(_darts.Count > 0)" InputLocked="@UserPreview.IsVisitFinished"
                              SubmitHint="@PreviewHint" SubmitHintTone="@PreviewTone" Disabled="@(!CanThrow)" />
            </div>
        </div>
        break;

    case Phase.Result when _state is not null:
        <div class="pa-result">
            <PlayerScoreboard Label="@(_state.IsUserWinner == true ? "Gewonnen" : _state.Status == DartBotGameStatusEnum.Aborted ? "Abgebrochen" : "Verloren")"
                              Value="@($"{_state.UserLegsWon} : {_state.BotLegsWon}")"
                              Status="@($"gegen {_state.BotName} · Best of {_state.BestOfLegs} · First to {X01SetRules.LegsToWin(_state.BestOfLegs)}")"
                              Tone="@(_state.IsUserWinner == true ? "success" : _state.IsUserWinner == false ? "danger" : null)" />
            @if (_state.BotXpGained is not null)
            {
                <PlayerStatGrid Stats="BotProgressStats" />
            }
            @if (_state.NewAchievements.Count > 0)
            {
                <div class="pa-new-achievements" role="status">
                    <strong>Neue Erfolge:</strong> @string.Join(" · ", _state.NewAchievements)
                    · <a href="player/achievements">Ansehen →</a>
                </div>
            }
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" @onclick="NewGameAsync">Neues Spiel</button>
                <a href="player" class="pl-btn pl-btn--ghost">Zur Übersicht</a>
            </div>
        </div>
        break;
}

@* Außerhalb des switch, damit die Handy-Verbindung beim Wechsel Spiel → Ergebnis bestehen bleibt (Schlussansage). *@
@if (_phase is Phase.Playing or Phase.Result && _state is not null)
{
    <RemoteInputBridge State="RemoteDisplay" OnDart="AddDart" OnUndo="UndoDart" OnSubmit="SubmitVisitAsync" />
}

@code {
    private enum Phase { Loading, Setup, Playing, Result }

    private const int DartsPerVisit = 3;

    /// <summary>Pause zwischen den Bot-Darts, damit man die Aufnahme verfolgen kann.</summary>
    private const int BotDartDelayMs = 550;

    private static readonly IReadOnlyList<PlayerChoice<int>> ScoreOptions = [new(301, "301"), new(501, "501")];
    private static readonly IReadOnlyList<PlayerChoice<int>> BestOfOptions =
        X01SetRules.AllowedBestOfLegs.Select(n => new PlayerChoice<int>(n, n.ToString(), $"First to {X01SetRules.LegsToWin(n)}")).ToList();
    private static readonly IReadOnlyList<PlayerChoice<bool>> StarterOptions = [new(true, "Ich"), new(false, "Bot")];
    private static readonly IReadOnlyList<PlayerChoice<X01InModeEnum>> InOptions =
        [new(X01InModeEnum.Straight, "Straight-In"), new(X01InModeEnum.Double, "Double-In")];
    private static readonly IReadOnlyList<PlayerChoice<X01OutModeEnum>> OutOptions =
        [new(X01OutModeEnum.Double, "Double-Out", "Finish mit Double"), new(X01OutModeEnum.Straight, "Straight-Out", "Jeder Dart zählt")];
    private static readonly IReadOnlyList<PlayerChoice<DartBotGameModeEnum>> ModeOptions =
    [
        new(DartBotGameModeEnum.Training, "Training", "Locker spielen"),
        new(DartBotGameModeEnum.Match, "Match", "Zählt als Wettkampf")
    ];

    private Phase _phase = Phase.Loading;
    private bool _busy;
    private string? _error;

    private List<DartBotSummary>? _bots;
    private int? _botId;
    private int _startingScore = 501;
    private int _bestOfLegs = X01SetRules.TrainingBestOfLegs;
    private bool _userStarts = true;
    private X01InModeEnum _inMode = X01InModeEnum.Straight;
    private X01OutModeEnum _outMode = X01OutModeEnum.Double;
    private DartBotGameModeEnum _gameMode = DartBotGameModeEnum.Training;

    private DartBotGameState? _state;
    private readonly List<DartThrowInput> _darts = [];
    private readonly List<DartBotThrowSummary> _botDarts = [];
    private string? _botVisitResult;
    private bool _animating;
    private bool _confirmAbort;
    private string? _status;
    private string? _tone;

    private int _userDarts;
    private int _userScored;
    private int _botDartsThrown;
    private int _botScored;

    private string HeaderTitle => _phase is Phase.Playing or Phase.Result && _state is not null
        ? $"Du gegen {_state.BotName}" : "Gegen Bot spielen";

    private string HeaderSubtitle => _state is not null && _phase is Phase.Playing or Phase.Result
        ? $"{_state.StartingScore} · Best of {_state.BestOfLegs} · {(_state.InMode == X01InModeEnum.Double ? "Double-In" : "Straight-In")} · {(_state.OutMode == X01OutModeEnum.Straight ? "Straight-Out" : "Double-Out")}"
        : "Wähle einen Gegner. Er lernt aus jedem Spiel gegen dich.";

    private bool IsUserActive => _state is { IsUserTurn: true } && !_animating;

    private bool CanThrow => IsUserActive && !_busy;

    /// <summary>
    /// Vorschau der eingegebenen, noch nicht gesendeten Darts (Double-In, Bust, Checkout); gewertet wird auf dem Server.
    /// </summary>
    private X01VisitPreviewResult UserPreview => _state is null
        ? default
        : X01VisitPreview.Evaluate(_state.UserRemaining, _state.IsUserOpened, _state.InMode, _state.OutMode, 0,
            _darts.Select(d => (d.Segment, d.Multiplier)));

    /// <summary>Rest während der Eingabe laut Vorschau.</summary>
    private int DisplayUserRemaining =>
        _shown is not null ? _shown.UserRemaining
        : _state is null ? 0 : UserPreview.Remaining;

    private string? PreviewHint => _darts.Count == 0 ? null
        : UserPreview.IsCheckout ? "Checkout!"
        : UserPreview.IsBust ? "Bust"
        : null;

    /// <summary>Anzeige für ein gekoppeltes Handy (Bot-Darts erscheinen als Statuszeile).</summary>
    private RemoteDisplayState RemoteDisplay => _state is null ? new() : new()
    {
        Title = HeaderTitle,
        Subtitle = $"Legs {_shown?.UserLegs ?? _state.UserLegsWon} : {_shown?.BotLegs ?? _state.BotLegsWon} · Leg {_shown?.LegNumber ?? _state.CurrentLegNumber}",
        Players =
        [
            new RemotePlayerState
            {
                Name = "Du",
                Value = DisplayUserRemaining.ToString(),
                Detail = _state.IsUserOpened ? null : "noch nicht eröffnet",
                Average = UserAverage,
                Legs = (_shown?.UserLegs ?? _state.UserLegsWon).ToString(),
                IsActive = IsUserActive
            },
            new RemotePlayerState
            {
                Name = _state.BotName,
                Value = (_shown?.BotRemaining ?? _state.BotRemaining).ToString(),
                Detail = _state.IsBotOpened ? "Bot" : "noch nicht eröffnet",
                Average = BotAverage,
                Legs = (_shown?.BotLegs ?? _state.BotLegsWon).ToString(),
                IsActive = _animating || (!IsUserActive && _state.Status == DartBotGameStatusEnum.Running)
            }
        ],
        Darts = RemoteState.Darts(_darts),
        VisitTotal = RemoteState.Total(_darts),
        Checkout = IsUserActive ? RemoteState.Checkout(UserCheckout) : null,
        Status = _botDarts.Count > 0
            ? $"{_state.BotName}: {string.Join(" ", _botDarts.Select(d => new DartThrowInput(d.Segment, d.Multiplier).Label))} {_botVisitResult}".Trim()
            : _status,
        StatusTone = _botDarts.Count > 0 ? null : _tone,
        Hint = PreviewHint,
        HintTone = PreviewTone,
        CanInput = CanThrow,
        InputLocked = UserPreview.IsVisitFinished,
        CanUndo = _darts.Count > 0,
        CanSubmit = _darts.Count > 0,
        IsFinished = _phase == Phase.Result,
        CallId = _callId,
        CallText = _callText
    };

    private int _callId;
    private string? _callText;
    private string? _playerName;

    /// <summary>
    /// Wer das neue Leg anwirft: Hat der Bot im neuen Leg schon geworfen, war er es; sonst ist der Mensch am Zug.
    /// </summary>
    private string? LegStarterName(DartBotGameState state)
    {
        var firstVisit = state.CurrentLegVisits.OrderBy(v => v.TurnNumber).FirstOrDefault();
        return firstVisit is { IsBot: true } || (firstVisit is null && !state.IsUserTurn) ? state.BotName : _playerName;
    }

    /// <summary>Ansage fürs Handy (Caller); das Handy spricht jede neue Ansage einmal.</summary>
    private void Announce(string text)
    {
        _callText = text;
        _callId++;
    }

    private string? PreviewTone => UserPreview.IsCheckout ? "success" : UserPreview.IsBust ? "danger" : null;

    /// <summary>
    /// Anzeige während der Bot-Animation: Der Server liefert den Stand nach der Bot-Aufnahme (ggf. schon im nächsten Leg).
    /// Bis die Darts gezeigt sind, gilt der Stand davor; der Bot-Rest zählt Dart für Dart herunter.
    /// </summary>
    private sealed record ShownScore(int UserLegs, int BotLegs, int LegNumber, int UserRemaining, int BotRemaining);

    private ShownScore? _shown;

    /// <summary>
    /// Checkout-Empfehlung für den Menschen, nach jedem eingegebenen Dart neu berechnet (im Browser, ohne Server):
    /// Vorschau-Rest mit den restlichen Darts der Aufnahme. Bei Double-In erst nach dem Eröffnen.
    /// </summary>
    private List<CheckoutSuggestion>? UserCheckout =>
        _state is null || !UserPreview.IsOpened || UserPreview.IsVisitFinished
            ? null
            : CheckoutAdvisor.GetBestRoutes(DisplayUserRemaining, DartsPerVisit - _darts.Count, _state.OutMode);

    private string UserAverage => _userDarts == 0 ? "–" : $"{_userScored * 3.0 / _userDarts:0.0}";

    /// <summary>Average des Bots in dieser Sitzung (wie beim Menschen aus den gewerteten Punkten laut Server).</summary>
    private string BotAverage => _botDartsThrown == 0 ? "–" : $"{_botScored * 3.0 / _botDartsThrown:0.0}";

    private void CountBotVisit(DartBotVisitSummary visit)
    {
        _botDartsThrown += visit.DartsUsed;
        _botScored += visit.ScoreBefore - visit.ScoreAfter;
    }

    private string StatusValue => _state is null ? "" : $"{_state.UserLegsWon} : {_state.BotLegsWon}";

    private IReadOnlyList<PlayerStat> BotProgressStats => _state is null ? [] :
    [
        new($"{_state.BotName} – XP", $"+{_state.BotXpGained}"),
        new("Elo vorher", _state.BotRatingBefore?.ToString() ?? "–"),
        new("Elo nachher", _state.BotRatingAfter?.ToString() ?? "–",
            Hint: _state.BotRatingAfter - _state.BotRatingBefore is { } diff ? (diff >= 0 ? $"+{diff}" : diff.ToString()) : null,
            Highlight: true),
        new("Dein Elo", _state.UserRatingAfter?.ToString() ?? "–",
            Hint: _state.UserRatingAfter - _state.UserRatingBefore is { } userDiff ? (userDiff >= 0 ? $"+{userDiff}" : userDiff.ToString()) : null)
    ];

    protected override async Task OnInitializedAsync()
    {
        _playerName = RemoteState.PlayerName(await Profile.EnsureLoadedAsync());

        // Laufendes Spiel fortsetzen, sonst Gegnerwahl.
        var running = await BotGameApi.GetRunningGameAsync();

        if (running.IsSuccess && running.Value is not null)
        {
            ShowGame(running.Value);
            _status = "Laufendes Spiel fortgesetzt";
            return;
        }

        await LoadBotsAsync();
    }

    private int? _userRating;

    private async Task LoadBotsAsync()
    {
        var botsTask = BotGameApi.GetAvailableBotsAsync();
        var profile = await ProfileApi.GetProfileAsync();
        var result = await botsTask;

        // Elo nur zur Markierung passender Gegner; ohne Profil bleibt die Liste unmarkiert.
        _userRating = profile.IsSuccess ? profile.Value!.Rating : null;
        _bots = result.Value;
        _error = result.Error;
        _botId ??= _bots?.OrderBy(b => _userRating is { } r ? Math.Abs(b.Rating - r) : 0).FirstOrDefault()?.Id;
        _phase = Phase.Setup;

        if (_botId is { } selected)
        {
            await SelectBotAsync(selected);
        }
    }

    private DartBotProfileCard? _card;

    /// <summary>Gegner wählen und seinen Steckbrief laden (Fehler beim Laden blenden nur den Steckbrief aus).</summary>
    private async Task SelectBotAsync(int botId)
    {
        _botId = botId;
        var result = await BotGameApi.GetBotProfileCardAsync(botId);
        _card = result.IsSuccess && _botId == botId ? result.Value : null;
    }

    private async Task StartAsync()
    {
        if (_botId is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        var result = await BotGameApi.StartGameAsync(new StartDartBotGameModel
        {
            DartBotId = _botId.Value,
            StartingScore = _startingScore,
            BestOfLegs = _gameMode == DartBotGameModeEnum.Training ? X01SetRules.TrainingBestOfLegs : _bestOfLegs,
            UserStarts = _userStarts,
            InMode = _inMode,
            OutMode = _outMode,
            GameMode = _gameMode
        });

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _userDarts = 0;
        _userScored = 0;
        _botDartsThrown = 0;
        _botScored = 0;
        _status = null;

        var state = result.Value!;

        // Hat der Bot den Anwurf, hat er bereits geworfen: Aufnahme zeigen.
        var botVisit = state.CurrentLegVisits.LastOrDefault(v => v.IsBot);
        if (botVisit is not null)
        {
            CountBotVisit(botVisit);
        }
        _state = state;
        _phase = Phase.Playing;
        // Hat der Bot schon geworfen, hat er angeworfen.
        Announce(RemoteState.LegStartCall(botVisit is not null ? state.BotName : _playerName));

        if (botVisit is not null)
        {
            await AnimateBotVisitAsync(botVisit, new ShownScore(state.UserLegsWon, state.BotLegsWon, state.CurrentLegNumber, state.UserRemaining, botVisit.ScoreBefore));
        }
    }

    /// <summary>Darts sammeln; abgeschickt wird erst mit „Senden“ (auch bei Checkout oder Bust).</summary>
    private void AddDart(DartThrowInput dart)
    {
        if (_state is null || UserPreview.IsVisitFinished)
        {
            return;
        }

        _darts.Add(dart);
        _botDarts.Clear();
        _botVisitResult = null;
        _error = null;
    }

    private void UndoDart()
    {
        if (_darts.Count > 0)
        {
            _darts.RemoveAt(_darts.Count - 1);
        }
    }

    private async Task SubmitVisitAsync()
    {
        if (_state is null || _darts.Count == 0)
        {
            return;
        }

        var previous = _state;
        var call = RemoteState.CallText(previous.UserRemaining - UserPreview.Remaining, UserPreview.IsBust, UserPreview.IsCheckout);

        _busy = true;
        _error = null;

        var result = await BotGameApi.AddVisitAsync(new DartBotUserVisitModel
        {
            GameId = previous.GameId,
            Throws = _darts.Select(d => new DartBotUserThrowModel { Segment = d.Segment, Multiplier = d.Multiplier }).ToList()
        });

        _busy = false;

        if (!result.IsSuccess)
        {
            // Z. B. weniger als drei Darts ohne Checkout/Bust: Darts bleiben stehen und können ergänzt werden.
            _error = result.Error;
            return;
        }

        var state = result.Value!;
        _darts.Clear();
        Announce(state.Status == DartBotGameStatusEnum.Finished && state.IsUserWinner == true
            ? RemoteState.MatchShotCall(_playerName)
            : call);

        // Eigene Aufnahme für den Average (gewertete Punkte laut Server).
        var userVisit = FindNewVisits(previous, state, isBot: false).LastOrDefault();
        if (userVisit is not null)
        {
            _userDarts += userVisit.DartsUsed;
            _userScored += userVisit.ScoreBefore - userVisit.ScoreAfter;
        }

        var botVisits = FindNewVisits(previous, state, isBot: true);
        botVisits.ForEach(CountBotVisit);
        var legChanged = state.CurrentLegNumber != previous.CurrentLegNumber;
        var userCheckedOut = state.UserLegsWon > previous.UserLegsWon;

        // Caller: nach dem eigenen Checkout gleich den Start des nächsten Legs ansagen.
        if (userCheckedOut && state.Status == DartBotGameStatusEnum.Running)
        {
            _callText = $"{_callText} {RemoteState.LegStartCall(LegStarterName(state))}";
        }

        // Leg-Ergebnis erst nach der Bot-Animation zeigen, sonst steht „Bot gewinnt“ vor dem ersten Bot-Dart.
        if (botVisits.Count == 0 || userCheckedOut)
        {
            ShowLegMessage(previous, state, userVisit);
        }

        _state = state;

        foreach (var visit in botVisits)
        {
            // Aufnahme aus dem alten Leg (Bot checkt): Stand des alten Legs zeigen, Legs erst danach hochzählen.
            var inOldLeg = legChanged && !userCheckedOut && state.PreviousLegVisits.Contains(visit);

            var shown = inOldLeg
                ? new ShownScore(previous.UserLegsWon, previous.BotLegsWon, previous.CurrentLegNumber,
                    userVisit?.ScoreAfter ?? previous.UserRemaining, visit.ScoreBefore)
                : new ShownScore(state.UserLegsWon, state.BotLegsWon, state.CurrentLegNumber, state.UserRemaining, visit.ScoreBefore);

            await AnimateBotVisitAsync(visit, shown);
        }

        if (botVisits.Count > 0 && !userCheckedOut)
        {
            ShowLegMessage(previous, state, userVisit);

            // Bot hat das Leg beendet: Start des nächsten Legs ansagen.
            if (legChanged && state.Status == DartBotGameStatusEnum.Running)
            {
                // Kurze Pause, damit „Game shot!“ des Bots vorher beim Handy ankommt.
                StateHasChanged();
                await Task.Delay(BotDartDelayMs);
                Announce(RemoteState.LegStartCall(LegStarterName(state)));
            }

            StateHasChanged();
        }

        if (state.Status != DartBotGameStatusEnum.Running)
        {
            _phase = Phase.Result;
        }
    }

    /// <summary>
    /// Neue Aufnahmen seit dem letzten Stand. Nach einem Leg-Wechsel: der Rest des alten Legs (inkl. Checkout)
    /// aus PreviousLegVisits und alle Aufnahmen des neuen Legs.
    /// </summary>
    private static List<DartBotVisitSummary> FindNewVisits(DartBotGameState previous, DartBotGameState current, bool isBot)
    {
        var lastKnownTurn = previous.CurrentLegVisits.Select(v => v.TurnNumber).DefaultIfEmpty(0).Max();

        var visits = current.CurrentLegNumber == previous.CurrentLegNumber
            ? current.CurrentLegVisits.Where(v => v.TurnNumber > lastKnownTurn)
            : current.PreviousLegVisits.Where(v => v.TurnNumber > lastKnownTurn).Concat(current.CurrentLegVisits);

        return visits.Where(v => v.IsBot == isBot).ToList();
    }

    private void ShowLegMessage(DartBotGameState previous, DartBotGameState state, DartBotVisitSummary? userVisit)
    {
        _status = LegMessage(previous, state, userVisit);
        _tone = state.UserLegsWon > previous.UserLegsWon ? "success" : state.BotLegsWon > previous.BotLegsWon ? "danger" : null;
    }

    private async Task AnimateBotVisitAsync(DartBotVisitSummary visit, ShownScore shown)
    {
        _animating = true;
        _botDarts.Clear();
        _botVisitResult = null;
        _shown = shown;
        StateHasChanged();

        var remaining = visit.ScoreBefore;

        foreach (var dart in visit.Throws.OrderBy(t => t.ThrowNumber))
        {
            await Task.Delay(BotDartDelayMs);
            _botDarts.Add(dart);

            // Vor dem Eröffnen (Double-In) zählt nichts; Bust: Stand bleibt bis zum Ende stehen und springt dann zurück.
            remaining = Math.Max(0, remaining - (visit.IsBust ? 0 : dart.Score));
            _shown = _shown with { BotRemaining = visit.IsBust ? visit.ScoreBefore : Math.Max(remaining, visit.ScoreAfter) };
            StateHasChanged();
        }

        _botVisitResult = visit.IsCheckout ? "Checkout!" : visit.IsBust ? "Bust" : $"= {visit.ScoreBefore - visit.ScoreAfter}";
        Announce(visit.IsCheckout && _state is { Status: DartBotGameStatusEnum.Finished, IsUserWinner: false }
            ? RemoteState.MatchShotCall(_state.BotName)
            : $"{_state?.BotName}: {RemoteState.CallText(visit.ScoreBefore - visit.ScoreAfter, visit.IsBust, visit.IsCheckout)}");
        _animating = false;
        _shown = null;
        StateHasChanged();
    }

    private string? LegMessage(DartBotGameState previous, DartBotGameState current, DartBotVisitSummary? userVisit)
    {
        if (current.Status == DartBotGameStatusEnum.Finished)
        {
            return current.IsUserWinner == true ? "Spiel gewonnen!" : $"{current.BotName} gewinnt das Spiel";
        }

        if (current.UserLegsWon > previous.UserLegsWon)
        {
            return $"Leg {previous.CurrentLegNumber} gewonnen!";
        }

        if (current.BotLegsWon > previous.BotLegsWon)
        {
            return $"Leg {previous.CurrentLegNumber} an {current.BotName}";
        }

        return userVisit?.IsBust == true ? "Bust – deine Aufnahme zählt nicht" : null;
    }

    private async Task AbortAsync()
    {
        if (_state is null)
        {
            return;
        }

        _busy = true;
        var result = await BotGameApi.AbortGameAsync(_state.GameId);
        _busy = false;
        _confirmAbort = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        var reloaded = await BotGameApi.GetGameAsync(_state.GameId);
        _state = reloaded.Value ?? _state;
        _phase = Phase.Result;
    }

    private async Task NewGameAsync()
    {
        _state = null;
        _darts.Clear();
        _botDarts.Clear();
        _status = null;
        _error = null;
        _phase = Phase.Loading;
        await LoadBotsAsync();
    }

    private void ShowGame(DartBotGameState state)
    {
        _state = state;
        _phase = state.Status == DartBotGameStatusEnum.Running ? Phase.Playing : Phase.Result;
    }

    private static string TargetLabel(DartBotThrowSummary dart) =>
        dart.TargetSegment is { } segment && dart.TargetMultiplier is { } multiplier
            ? new DartThrowInput(segment, multiplier).Label
            : "–";
}
