@page "/player/tournaments/match/{MatchId:int}"
@using global::Shared.Enums.Tournament
@using global::Shared.Models.Remote
@using global::Shared.Models.Shared
@using global::Shared.Models.Tournament
@implements IDisposable
@inject ITournamentApi TournamentApi
@inject IJSRuntime JS

@*
    Eingabe-Screen für Turnier-Matches: links die Tafel (Rechnung wie mit Kreide), rechts oben der Spielstand,
    rechts unten die Eingabe je Dart mit Korrektur. Zuschauer und Bot-Züge: Nachladen alle 3 Sekunden.
*@

<PageTitle>@(_state is null ? "Match" : $"{_state.Home.DisplayName} – {_state.Away.DisplayName}") – DartMetrics</PageTitle>

<PlayerPageHeader Eyebrow="@(_state is null ? "Turnier" : $"{_state.TournamentName} · {_state.RoundName}")"
                  Title="@(_state is null ? "Match" : $"{_state.Home.DisplayName} – {_state.Away.DisplayName}")"
                  Subtitle="@(_state is null ? null : $"Best of {_state.BestOfLegs} · First to {_state.LegsToWin} · {_state.StartingScore}")">
    <Actions>
        @if (_state is not null)
        {
            <a class="pl-btn pl-btn--link" href="@TournamentLinks.Detail(_state.TournamentId, _state.TournamentType == TournamentTypeEnum.Knockout)">Zum Turnier</a>
            <button type="button" class="pl-btn pl-btn--link" aria-pressed="@(_callerOn ? "true" : "false")" @onclick="ToggleCaller">Caller @(_callerOn ? "an" : "aus")</button>
        }
    </Actions>
</PlayerPageHeader>

@if (_error is not null)
{
    <p class="pl-alert" role="alert">@_error</p>
}

@if (_state is null)
{
    if (_error is null)
    {
        <PlayerLoadingState />
    }
}
else
{
    var s = _state;
    var leg = ShownLeg;

    <div class="pa-conduct">
        <section class="pa-conduct__chalk pa-chalk" aria-label="Tafel">
            <div class="pa-chalk__head">
                <span>Leg @(leg?.LegNumber ?? s.LegNumber)</span>
                <span>@s.Home.LegsWon : @s.Away.LegsWon</span>
            </div>
            <div class="pa-chalk__board">
                @foreach (var player in new[] { 1, 2 })
                {
                    var side = player == 1 ? s.Home : s.Away;
                    var rows = ChalkRows(leg, player);
                    <div class="pa-chalk__column">
                        <p class="pa-chalk__name @(s.Status == TournamentMatchStatusEnum.Running && s.CurrentPlayer == player && leg?.LegNumber == s.LegNumber ? "is-active" : "")">@side.DisplayName</p>
                        <ul class="pa-chalk__list">
                            <li class="pa-chalk__row @(rows.Count > 0 ? "is-crossed" : "")">
                                <span class="pa-chalk__scored"></span>
                                <span class="pa-chalk__rest">@s.StartingScore</span>
                            </li>
                            @for (var i = 0; i < rows.Count; i++)
                            {
                                var row = rows[i];
                                var last = i == rows.Count - 1;
                                <li class="pa-chalk__row @(last ? "" : "is-crossed") @(row.IsBust ? "is-bust" : "") @(row.IsCheckout ? "is-checkout" : "")">
                                    <span class="pa-chalk__scored">@(row.IsBust ? "—" : (row.ScoreBefore - row.ScoreAfter).ToString())</span>
                                    <span class="pa-chalk__rest">@(row.IsCheckout ? "✓" : row.ScoreAfter.ToString())</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            @if (s.Legs.Count > 1)
            {
                <div class="pa-chalk__legs" role="group" aria-label="Leg wählen">
                    @foreach (var l in s.Legs)
                    {
                        var number = l.LegNumber;
                        <button type="button" class="pl-btn @(number == (leg?.LegNumber ?? 0) ? "pl-btn--ghost" : "pl-btn--link")"
                                @onclick="() => _shownLeg = number == s.Legs[^1].LegNumber ? null : number">
                            Leg @number@(l.WinnerPlayer is int w ? $" · {(w == 1 ? s.Home.DisplayName : s.Away.DisplayName)}" : "")
                        </button>
                    }
                </div>
            }
        </section>

        <div class="pa-conduct__info">
            <div class="pa-duel">
                <div class="pa-duel__player @(s.Status == TournamentMatchStatusEnum.Running && s.CurrentPlayer == 1 ? "is-active" : "")">
                    <p class="pa-duel__name">@s.Home.DisplayName</p>
                    <p class="pa-duel__score">@s.Home.Remaining</p>
                    <p class="pa-duel__meta">@SideMeta(s.Home)</p>
                </div>
                <div class="pa-duel__legs">
                    Legs
                    <strong>@s.Home.LegsWon : @s.Away.LegsWon</strong>
                    Leg @s.LegNumber
                </div>
                <div class="pa-duel__player @(s.Status == TournamentMatchStatusEnum.Running && s.CurrentPlayer == 2 ? "is-active" : "")">
                    <p class="pa-duel__name">@s.Away.DisplayName</p>
                    <p class="pa-duel__score">@s.Away.Remaining</p>
                    <p class="pa-duel__meta">@SideMeta(s.Away)</p>
                </div>
            </div>

            @switch (s.Status)
            {
                case TournamentMatchStatusEnum.Finished:
                    <PlayerScoreboard Label="Beendet" Value="@($"{s.Home.LegsWon} : {s.Away.LegsWon}")"
                                      Status="@($"Sieger {(s.WinnerParticipantId == s.Home.ParticipantId ? s.Home.DisplayName : s.Away.DisplayName)}")" Tone="success" />
                    break;
                case TournamentMatchStatusEnum.Scheduled:
                    <PlayerScoreboard Label="Geplant" Value="–" Status="@(s.ScheduledAt is DateTime at ? $"Termin {at.ToLocalTime():g}" : "noch kein Termin")" />
                    break;
                default:
                    <CheckoutHint Suggestions="ShownSuggestions" />
                    break;
            }
        </div>

        <div class="pa-conduct__input">
            @if (s.CanEnterDarts)
            {
                <p class="pa-section__hint">Am Wurf: <strong>@(s.CurrentPlayer == 1 ? s.Home.DisplayName : s.Away.DisplayName)</strong></p>
                <DartInputPad CurrentDarts="CurrentDarts" OnDart="AddDart" OnUndo="UndoAsync" CanUndo="@(_pending.Count > 0 || s.CanUndo)"
                              OnSubmit="SubmitVisitAsync" CanSubmit="@(_pending.Count > 0)" InputLocked="@Preview.IsVisitFinished"
                              SubmitHint="@PreviewHint" SubmitHintTone="@PreviewTone" Disabled="@(_busy || _submitting)" />
            }
            else if (s.Status == TournamentMatchStatusEnum.Running)
            {
                <p class="pa-section__hint">@(s.CanUndo ? "Ein Bot wirft …" : "Live – der Stand lädt automatisch nach.")</p>
            }

            @if (s.Status == TournamentMatchStatusEnum.Running)
            {
                <RemoteInputBridge State="RemoteDisplay" OnDart="AddDart" OnUndo="UndoAsync" OnSubmit="SubmitVisitAsync" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public int MatchId { get; set; }

    private const int PollSeconds = 3;

    private TournamentMatchState? _state;
    private string? _error;
    private bool _busy;
    private int? _shownLeg;
    private Timer? _timer;
    private bool _callerOn;

    private TournamentLegItem? ShownLeg =>
        _state?.Legs.FirstOrDefault(l => l.LegNumber == _shownLeg) ?? CurrentLeg;

    /// <summary>Das laufende Leg; nach einem Checkout (neues Leg noch ohne Aufnahme) das zuletzt gespielte.</summary>
    private TournamentLegItem? CurrentLeg =>
        _state?.Legs.FirstOrDefault(l => l.LegNumber == _state.LegNumber) ?? _state?.Legs.LastOrDefault();

    /// <summary>Eingegebene, noch nicht gesendete Darts; gehen erst mit „Senden“ an den Server.</summary>
    private readonly List<DartThrowInput> _pending = [];
    private bool _submitting;

    /// <summary>Vom Server gewertete Darts der laufenden Aufnahme plus die noch nicht gesendeten.</summary>
    private IReadOnlyList<DartThrowInput> CurrentDarts =>
        (_state?.CurrentVisit.Select(d => new DartThrowInput(d.Segment, d.Multiplier)) ?? Enumerable.Empty<DartThrowInput>()).Concat(_pending).ToList();

    /// <summary>Anzeige für ein gekoppeltes Handy.</summary>
    private RemoteDisplayState RemoteDisplay => _state is not { } s ? new() : new()
    {
        Title = $"{s.Home.DisplayName} – {s.Away.DisplayName}",
        Subtitle = $"{s.TournamentName} · Legs {s.Home.LegsWon} : {s.Away.LegsWon} · Leg {s.LegNumber}",
        Players =
        [
            new RemotePlayerState
            {
                Name = s.Home.DisplayName,
                Value = (s.CurrentPlayer == 1 && _pending.Count > 0 ? Preview.Remaining : s.Home.Remaining).ToString(),
                Detail = SideMeta(s.Home),
                IsActive = s.CurrentPlayer == 1
            },
            new RemotePlayerState
            {
                Name = s.Away.DisplayName,
                Value = (s.CurrentPlayer == 2 && _pending.Count > 0 ? Preview.Remaining : s.Away.Remaining).ToString(),
                Detail = SideMeta(s.Away),
                IsActive = s.CurrentPlayer == 2
            }
        ],
        Darts = RemoteState.Darts(CurrentDarts),
        VisitTotal = RemoteState.Total(CurrentDarts),
        Checkout = RemoteState.Checkout(ShownSuggestions),
        Status = _error,
        StatusTone = _error is null ? null : "danger",
        Hint = PreviewHint,
        HintTone = PreviewTone,
        CanInput = s.CanEnterDarts && !_busy && !_submitting,
        InputLocked = Preview.IsVisitFinished,
        CanUndo = _pending.Count > 0 || s.CanUndo,
        CanSubmit = _pending.Count > 0,
        IsFinished = s.Status == TournamentMatchStatusEnum.Finished
    };

    private TournamentMatchSide? ActiveSide => _state is null ? null : _state.CurrentPlayer == 1 ? _state.Home : _state.Away;

    /// <summary>Vorschau der noch nicht gesendeten Darts: Bust/Checkout sofort anzeigen, gewertet wird auf dem Server.</summary>
    private X01VisitPreviewResult Preview => _state is null || ActiveSide is null
        ? default
        : X01VisitPreview.Evaluate(ActiveSide.Remaining, ActiveSide.IsOpened, _state.InMode, _state.OutMode,
            _state.CurrentVisit.Count, _pending.Select(d => (d.Segment, d.Multiplier)));

    private string? PreviewHint => _pending.Count == 0 ? null
        : Preview.IsCheckout ? "Checkout!"
        : Preview.IsBust ? "Bust"
        : null;

    private string? PreviewTone => Preview.IsCheckout ? "success" : Preview.IsBust ? "danger" : null;

    private List<CheckoutSuggestion>? ShownSuggestions =>
        _state is null ? null
        : _pending.Count == 0 ? _state.CheckoutSuggestions
        : Preview.IsVisitFinished || !Preview.IsOpened ? null
        : CheckoutAdvisor.GetBestRoutes(Preview.Remaining,
            X01VisitPreview.DartsPerVisit - _state.CurrentVisit.Count - _pending.Count, _state.OutMode);

    private static List<TournamentVisitItem> ChalkRows(TournamentLegItem? leg, int player) =>
        leg?.Visits.Where(v => v.PlayerNumber == player).OrderBy(v => v.VisitNumber).ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        _timer ??= new Timer(async _ => await PollAsync(), null, TimeSpan.FromSeconds(PollSeconds), TimeSpan.FromSeconds(PollSeconds));
    }

    private async Task LoadAsync()
    {
        var result = await TournamentApi.GetMatchAsync(MatchId);
        _state = result.Value ?? _state;
        _error = result.Error;
        await CallLastVisitAsync();
    }

    private void ToggleCaller()
    {
        _callerOn = !_callerOn;

        // Beim Einschalten nichts Altes ansagen.
        _lastCalled = FinishedVisits().LastOrDefault().Key;
    }

    private (int Leg, int Visit) _lastCalled;

    /// <summary>
    /// Ansage jeder neu abgeschlossenen Aufnahme (eigene und die Antwort des Bots, in Reihenfolge):
    /// Summe, „No score“ bei Bust, „Game shot“ beim Checkout.
    /// </summary>
    private async Task CallLastVisitAsync()
    {
        var finished = FinishedVisits();
        var fresh = finished.Where(f => f.Key.CompareTo(_lastCalled) > 0).ToList();

        // Nach einer Korrektur kann der Stand zurückgehen: dann nur merken.
        _lastCalled = finished.LastOrDefault().Key;

        if (!_callerOn)
        {
            return;
        }

        foreach (var (_, visit) in fresh)
        {
            var scored = visit.ScoreBefore - visit.ScoreAfter;
            var text = visit.IsCheckout ? "Game shot!" : visit.IsBust || scored == 0 ? "No score" : scored == 180 ? "One hundred and eighty!" : scored.ToString();

            try
            {
                await JS.InvokeVoidAsync("dartCaller.say", text);
            }
            catch (JSException)
            {
                // Ohne Sprachausgabe im Browser einfach stumm.
                return;
            }
        }
    }

    private List<((int Leg, int Visit) Key, TournamentVisitItem Visit)> FinishedVisits() =>
        _state?.Legs
            .SelectMany(l => l.Visits
                .Where(v => v.IsBust || v.IsCheckout || v.Darts.Count == 3)
                .Select(v => ((l.LegNumber, v.VisitNumber), v)))
            .OrderBy(x => x.Item1)
            .ToList() ?? [];

    private async Task PollAsync()
    {
        if (_busy || _submitting || _pending.Count > 0 || _state is null || _state.Status == TournamentMatchStatusEnum.Finished || _state.CanEnterDarts)
        {
            return;
        }

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void AddDart(DartThrowInput dart)
    {
        if (_state is null || Preview.IsVisitFinished)
        {
            return;
        }

        _error = null;
        _pending.Add(dart);
    }

    /// <summary>Erst noch nicht gesendete Darts zurücknehmen, danach wie bisher den letzten gewerteten Dart auf dem Server.</summary>
    private Task UndoAsync()
    {
        if (_pending.Count > 0)
        {
            _pending.RemoveAt(_pending.Count - 1);
            return Task.CompletedTask;
        }

        return SendAsync(() => TournamentApi.UndoDartAsync(MatchId, _state!.ConcurrencyStamp));
    }

    /// <summary>Schickt die gesammelten Darts nacheinander; der Server wertet jeden Dart wie bisher.</summary>
    private async Task SubmitVisitAsync()
    {
        if (_state is null || _pending.Count == 0 || _submitting)
        {
            return;
        }

        var darts = _pending.ToList();
        _pending.Clear();
        _submitting = true;

        try
        {
            for (var i = 0; i < darts.Count; i++)
            {
                var player = _state!.CurrentPlayer;
                var leg = _state.LegNumber;

                var ok = await SendAsync(() => TournamentApi.AddDartAsync(MatchId, new AddTournamentDartModel
                {
                    Segment = darts[i].Segment,
                    Multiplier = darts[i].Multiplier,
                    ConcurrencyStamp = _state!.ConcurrencyStamp
                }));

                if (!ok)
                {
                    // Nicht gewertete Darts bleiben stehen und können korrigiert oder erneut gesendet werden.
                    _pending.AddRange(darts.Skip(i));
                    break;
                }

                var visitEnded = _state is null || !_state.CanEnterDarts || _state.CurrentPlayer != player
                    || _state.LegNumber != leg || _state.CurrentVisit.Count == 0;

                // Server hat die Aufnahme früher beendet als die Vorschau: übrige Darts nicht dem nächsten Wurf zuordnen.
                if (visitEnded && i < darts.Count - 1)
                {
                    _error = $"Die Aufnahme war nach Dart {i + 1} beendet – die übrigen Darts wurden nicht gewertet.";
                    break;
                }
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<bool> SendAsync(Func<Task<ApiResult<TournamentMatchState>>> request)
    {
        if (_state is null)
        {
            return false;
        }

        _busy = true;
        var result = await request();

        if (result.IsSuccess)
        {
            _state = result.Value;
            _error = null;
            _shownLeg = null;
            await CallLastVisitAsync();
        }
        else
        {
            // z. B. 409 von einem zweiten Gerät: Stand neu laden, Meldung behalten.
            var error = result.Error;
            await LoadAsync();
            _error = error;
        }

        _busy = false;
        return result.IsSuccess;
    }

    private static string SideMeta(TournamentMatchSide side) =>
        (side.ParticipantType == TournamentParticipantTypeEnum.Bot ? "Bot · " : "") + $"Ø {side.Average:0.0}" + (side.IsOpened ? "" : " · nicht eröffnet");

    public void Dispose() => _timer?.Dispose();
}
