@page "/player/training"

<PageTitle>Training – DartMetrics</PageTitle>

<PlayerPageHeader Eyebrow="Üben" Title="Training"
                  Subtitle="Wähle ein Training. Jeder Dart wird einzeln erfasst und ausgewertet." />

<div class="pa-grid">
    <PlayerCard Title="X01" Icon="PlayerIconName.Training" Href="player/training/x01"
                Text="301 oder 501 allein spielen, ein Satz aus 5 Legs – mit Straight- oder Double-In und Double- oder Straight-Out."
                Meta="Starten →" />
    <PlayerCard Title="Around the Clock" Icon="PlayerIconName.Play" Href="player/training/around-the-clock" Accent="green"
                Text="Triff die Segmente 1 bis 20 der Reihe nach, danach 25 und Bull."
                Meta="Starten →" />
    <PlayerCard Title="Checkout" Icon="PlayerIconName.Chart" Href="player/training/checkout" Accent="red"
                Text="Übe ein Finish immer wieder: bis zu drei Darts pro Versuch, Double-Out."
                Meta="Starten →" />
    <PlayerCard Title="Segment" Icon="PlayerIconName.Training" Href="player/training/segment"
                Text="Ein Zielfeld über mehrere Aufnahmen treffen – Trefferquote im Blick."
                Meta="Starten →" />
    <PlayerCard Title="Bob's 27" Icon="PlayerIconName.Chart" Href="player/training/bobs27" Accent="green"
                Text="Doubles von D1 bis D20 und Bull: Start mit 27 Punkten, Treffer bringen Punkte, Fehlversuche kosten. Allein oder mit Mitspielern."
                Meta="Starten →" />
</div>
