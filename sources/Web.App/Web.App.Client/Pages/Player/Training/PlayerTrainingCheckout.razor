@page "/player/training/checkout"
@using global::Shared.Enums.X01
@using global::Shared.Models.Remote
@using global::Shared.Models.Shared
@using global::Shared.Models.Training
@inject ITrainingApi TrainingApi

<PageTitle>Checkout-Training – DartMetrics</PageTitle>

<PlayerPageHeader Eyebrow="Training" Title="Checkout"
                  Subtitle="@(_phase == Phase.Setup ? "Übe ein Finish: bis zu drei Darts pro Versuch, Abschluss mit Double." : $"Ziel {_targetScore} · Double-Out")">
    <Actions>
        @if (_phase == Phase.Playing)
        {
            <button type="button" class="pl-btn pl-btn--ghost" disabled="@_busy" @onclick="FinishAsync">Beenden</button>
        }
        else
        {
            <a href="player/training" class="pl-btn pl-btn--link">← Alle Trainings</a>
        }
    </Actions>
</PlayerPageHeader>

@if (_error is not null)
{
    <PlayerErrorState Text="@_error" />
}

@switch (_phase)
{
    case Phase.Setup:
        <div class="pa-setup">
            <PlayerChoiceGroup Label="Zielwert" Options="TargetOptions" @bind-Value="_targetScore" />
            <div class="pl-field">
                <label for="checkout-target">Eigener Zielwert (2–170)</label>
                <input id="checkout-target" class="pl-input" type="number" min="2" max="170" inputmode="numeric"
                       value="@_targetScore" @onchange="OnTargetChanged" />
            </div>
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" disabled="@(_busy || !IsValidTarget)" @onclick="StartAsync">
                    @(_busy ? "Startet …" : "Training starten")
                </button>
            </div>
        </div>
        break;

    case Phase.Playing:
        <div class="pa-play">
            <div class="pa-play__info">
                <PlayerScoreboard Label="@($"Versuch {_attemptNumber} · Rest")" Value="@Preview.Remaining.ToString()" Status="@_status" Tone="@_tone">
                    <CheckoutHint Suggestions="ShownSuggestions" />
                </PlayerScoreboard>
                <PlayerStatGrid Stats="LiveStats" />
            </div>
            <DartInputPad CurrentDarts="_darts" OnDart="AddDart" OnUndo="UndoDart" CanUndo="@(_pending.Count > 0)"
                          OnSubmit="SubmitVisitAsync" CanSubmit="@(_pending.Count > 0)" InputLocked="@Preview.IsVisitFinished"
                          SubmitHint="@PreviewHint" SubmitHintTone="@PreviewTone" Disabled="@(_busy || _submitting)" />
            <RemoteInputBridge State="RemoteDisplay" OnDart="AddDart" OnUndo="UndoDart" OnSubmit="SubmitVisitAsync" />
        </div>
        break;

    case Phase.Result when _result is not null:
        <div class="pa-result">
            <PlayerScoreboard Label="@($"Checkout-Quote auf {_result.TargetScore}")" Value="@($"{_result.CheckoutRate:0.#} %")"
                              Status="@($"{_result.SuccessfulAttempts} von {_result.TotalAttempts} Versuchen")"
                              Tone="@(_result.SuccessfulAttempts > 0 ? "success" : null)" />
            <PlayerStatGrid Stats="ResultStats" />
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" @onclick="Restart">Neues Training</button>
                <a href="player/training" class="pl-btn pl-btn--ghost">Alle Trainings</a>
            </div>
        </div>
        break;
}

@code {
    private enum Phase { Setup, Playing, Result }

    private static readonly IReadOnlyList<PlayerChoice<int>> TargetOptions =
    [
        new(40, "40", "D20"),
        new(81, "81", "T19 · D12"),
        new(100, "100", "T20 · D20"),
        new(121, "121", "3 Darts"),
        new(170, "170", "Big Fish")
    ];

    private Phase _phase = Phase.Setup;
    private bool _busy;
    private string? _error;

    private int _targetScore = 40;

    private int _trainingId;
    private int _attemptNumber = 1;
    private int _throwNumber = 1;
    private int _remaining;
    private int _successful;
    private int _dartsThrown;
    private readonly List<DartThrowInput> _darts = [];
    /// <summary>Eingegebene, noch nicht gesendete Darts (Ende von _darts).</summary>
    private readonly List<DartThrowInput> _pending = [];
    private bool _submitting;
    private bool _clearDartsOnNext;
    private List<CheckoutSuggestion>? _suggestions;
    private string? _status;
    private string? _tone;

    private CheckoutTrainingResult? _result;

    /// <summary>Darts des laufenden Versuchs, die der Server schon gewertet hat (z. B. nach dem Fortsetzen).</summary>
    private int CommittedInVisit => _clearDartsOnNext ? 0 : _darts.Count - _pending.Count;

    /// <summary>Vorschau (Double-Out): Bust/Checkout sofort anzeigen, gewertet wird auf dem Server.</summary>
    private X01VisitPreviewResult Preview => X01VisitPreview.Evaluate(
        _remaining, true, X01InModeEnum.Straight, X01OutModeEnum.Double,
        CommittedInVisit, _pending.Select(d => (d.Segment, d.Multiplier)));

    private string? PreviewHint => _pending.Count == 0 ? null
        : Preview.IsCheckout ? "Checkout!"
        : Preview.IsBust ? "Bust"
        : null;

    private string? PreviewTone => Preview.IsCheckout ? "success" : Preview.IsBust ? "danger" : null;

    private List<CheckoutSuggestion>? ShownSuggestions =>
        _pending.Count == 0 ? _suggestions
        : Preview.IsVisitFinished ? null
        : CheckoutAdvisor.GetBestRoutes(Preview.Remaining, X01VisitPreview.DartsPerVisit - CommittedInVisit - _pending.Count);

    /// <summary>Anzeige für ein gekoppeltes Handy.</summary>
    private RemoteDisplayState RemoteDisplay => new()
    {
        Title = "Checkout-Training",
        Subtitle = $"Ziel {_targetScore} · Versuch {_attemptNumber}",
        Players = [new RemotePlayerState { Name = "Rest", Value = Preview.Remaining.ToString(), Detail = $"{_successful} Checkouts", IsActive = true }],
        Darts = RemoteState.Darts(_darts),
        VisitTotal = RemoteState.Total(_darts),
        Checkout = RemoteState.Checkout(ShownSuggestions),
        Status = _status,
        StatusTone = _tone,
        Hint = PreviewHint,
        HintTone = PreviewTone,
        CanInput = !_busy && !_submitting,
        InputLocked = Preview.IsVisitFinished,
        CanUndo = _pending.Count > 0,
        CanSubmit = _pending.Count > 0,
        CallId = _callId,
        CallText = _callText
    };

    private int _callId;
    private string? _callText;

    private bool IsValidTarget => _targetScore is >= 2 and <= 170;

    private IReadOnlyList<PlayerStat> LiveStats =>
    [
        new("Versuche", (_attemptNumber - 1).ToString()),
        new("Checkouts", _successful.ToString()),
        new("Quote", _attemptNumber <= 1 ? "–" : $"{_successful * 100.0 / (_attemptNumber - 1):0} %"),
        new("Darts", _dartsThrown.ToString())
    ];

    private IReadOnlyList<PlayerStat> ResultStats => _result is null ? [] :
    [
        new("Checkouts", _result.SuccessfulAttempts.ToString(), Highlight: true),
        new("Versuche", _result.TotalAttempts.ToString()),
        new("Darts", _result.TotalThrows.ToString()),
        new("Ø Darts je Checkout", _result.SuccessfulAttempts == 0 ? "–" : $"{_result.AverageDartsPerCheckout:0.0}"),
        new("Schnellster Checkout", _result.SuccessfulAttempts == 0 ? "–" : $"{_result.FewestDartsForCheckout} Darts"),
        new("Ø pro Dart", $"{_result.AverageScorePerThrow:0.0}")
    ];

    private void OnTargetChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            _targetScore = value;
        }
    }

    // Offenes Training nach Reload oder Navigation fortsetzen, sonst Einstellungen zeigen.
    protected override async Task OnInitializedAsync()
    {
        var running = await TrainingApi.GetRunningCheckoutAsync();

        if (!running.IsSuccess || running.Value is not { } training)
        {
            return;
        }

        _trainingId = training.TrainingId;
        _attemptNumber = training.NextVisitNumber;
        _throwNumber = training.NextThrowNumber;
        _dartsThrown = training.DartsThrown;
        _darts.Clear();
        _pending.Clear();
        _darts.AddRange(training.CurrentVisitDarts.Select(d => new DartThrowInput(d.Segment, d.Multiplier)));
        _clearDartsOnNext = false;
        _targetScore = training.TargetScore;
        _remaining = training.RemainingScore;
        _successful = training.SuccessfulAttempts;
        _suggestions = training.CheckoutSuggestions.Count > 0 ? training.CheckoutSuggestions : null;
        _status = "Offenes Training fortgesetzt";
        _tone = null;
        _phase = Phase.Playing;
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;

        var result = await TrainingApi.StartCheckoutAsync(new StartCheckoutTrainingModel { TargetScore = _targetScore });

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _trainingId = result.Value;
        _attemptNumber = 1;
        _throwNumber = 1;
        _remaining = _targetScore;
        _successful = 0;
        _dartsThrown = 0;
        _darts.Clear();
        _pending.Clear();
        _clearDartsOnNext = false;
        _suggestions = null;
        _status = null;
        _tone = null;
        _phase = Phase.Playing;
    }

    private void AddDart(DartThrowInput dart)
    {
        if (_clearDartsOnNext)
        {
            _darts.Clear();
            _clearDartsOnNext = false;
            _remaining = _targetScore;
        }

        if (Preview.IsVisitFinished)
        {
            return;
        }

        _error = null;
        _pending.Add(dart);
        _darts.Add(dart);
    }

    private void UndoDart()
    {
        if (_pending.Count == 0)
        {
            return;
        }

        _pending.RemoveAt(_pending.Count - 1);
        _darts.RemoveAt(_darts.Count - 1);
    }

    /// <summary>Schickt die gesammelten Darts nacheinander; der Server wertet jeden Dart wie bisher.</summary>
    private async Task SubmitVisitAsync()
    {
        if (_pending.Count == 0 || _submitting)
        {
            return;
        }

        var darts = _pending.ToList();

        // Ansage fürs Handy, sobald die Aufnahme laut Vorschau zu Ende ist.
        if (Preview.IsVisitFinished)
        {
            _callText = RemoteState.CallText(_remaining - Preview.Remaining, Preview.IsBust, Preview.IsCheckout);
            _callId++;
        }

        _pending.Clear();
        _darts.RemoveRange(_darts.Count - darts.Count, darts.Count);
        _submitting = true;

        try
        {
            for (var i = 0; i < darts.Count; i++)
            {
                // Server hat den Versuch früher beendet als die Vorschau: übrige Darts nicht in den nächsten schieben.
                if (i > 0 && (_clearDartsOnNext || _phase != Phase.Playing))
                {
                    _error = $"Der Versuch war nach Dart {i} beendet – die übrigen Darts wurden nicht gewertet.";
                    break;
                }

                await CommitDartAsync(darts[i]);

                if (_error is not null)
                {
                    var rest = darts.Skip(i).ToList();
                    _pending.AddRange(rest);
                    _darts.AddRange(rest);
                    break;
                }
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CommitDartAsync(DartThrowInput dart)
    {
        _busy = true;
        _error = null;

        var result = await TrainingApi.AddCheckoutThrowAsync(new CheckoutTrainingThrow
        {
            TrainingId = _trainingId,
            AttemptNumber = _attemptNumber,
            ThrowNumber = _throwNumber,
            Segment = dart.Segment,
            Multiplier = dart.Multiplier
        });

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        var value = result.Value!;
        _darts.Add(dart);
        _dartsThrown++;
        _successful = value.SuccessfulAttempts;
        _remaining = value.IsCheckout ? 0 : value.RemainingScore;
        _suggestions = value.CheckoutSuggestions;

        if (value.IsAttemptFinished)
        {
            (_status, _tone) = value.IsCheckout ? ("Checkout! Nächster Versuch", "success")
                : value.IsBust ? ("Bust – nächster Versuch", "danger")
                : ("Nicht geschafft – nächster Versuch", (string?)null);

            _attemptNumber++;
            _throwNumber = 1;
            _clearDartsOnNext = true;
            // Nach Bust/Fehlversuch zeigt der Hinweis schon den Weg für den nächsten Versuch; nach Checkout steht "Rest 0".
            if (value.IsCheckout)
                _suggestions = null;
        }
        else
        {
            _status = null;
            _tone = null;
            _throwNumber++;
        }
    }

    private async Task FinishAsync()
    {
        _busy = true;
        var result = await TrainingApi.FinishCheckoutAsync(_trainingId);
        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        var loaded = await TrainingApi.GetCheckoutResultAsync(_trainingId);

        if (!loaded.IsSuccess)
        {
            _error = loaded.Error;
            return;
        }

        _result = loaded.Value;
        _phase = Phase.Result;
    }

    private void Restart()
    {
        _result = null;
        _error = null;
        _phase = Phase.Setup;
    }
}
