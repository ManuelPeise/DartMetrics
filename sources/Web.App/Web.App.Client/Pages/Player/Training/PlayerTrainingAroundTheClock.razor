@page "/player/training/around-the-clock"
@using global::Shared.Models.Training
@inject ITrainingApi TrainingApi

<PageTitle>Around the Clock – DartMetrics</PageTitle>

<PlayerPageHeader Eyebrow="Training" Title="Around the Clock"
                  Subtitle="Triff 1 bis 20 der Reihe nach, danach 25 und Bull. Single, Double und Triple zählen.">
    <Actions>
        @if (_phase == Phase.Playing)
        {
            <button type="button" class="pl-btn pl-btn--ghost" disabled="@_busy" @onclick="FinishAsync">Beenden</button>
        }
        else
        {
            <a href="player/training" class="pl-btn pl-btn--link">← Alle Trainings</a>
        }
    </Actions>
</PlayerPageHeader>

@if (_error is not null)
{
    <PlayerErrorState Text="@_error" />
}

@switch (_phase)
{
    case Phase.Setup:
        <div class="pa-setup">
            <p class="pa-page-subtitle" style="margin: 0">22 Ziele: die Segmente 1–20, dann 25 (Single Bull) und Bull. Gezählt werden die Darts bis zum Ziel.</p>
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" disabled="@_busy" @onclick="StartAsync">
                    @(_busy ? "Startet …" : "Training starten")
                </button>
            </div>
        </div>
        break;

    case Phase.Playing:
        <div class="pa-play">
            <div class="pa-play__info">
                <PlayerScoreboard Label="Ziel" Value="@TargetLabel(_target)" Status="@_status" Tone="@_tone">
                    <div class="pa-progress" style="margin-top: 1rem" role="progressbar"
                         aria-valuemin="0" aria-valuemax="@TargetCount" aria-valuenow="@(_target - 1)">
                        <div class="pa-progress__fill" style="width: @((_target - 1) * 100 / TargetCount)%"></div>
                    </div>
                </PlayerScoreboard>
                <PlayerStatGrid Stats="LiveStats" />
            </div>
            <DartInputPad CurrentDarts="_darts" OnDart="AddDart" OnUndo="UndoDart" CanUndo="@(_pending.Count > 0)"
                          OnSubmit="SubmitVisitAsync" CanSubmit="@(_pending.Count > 0)" InputLocked="@IsVisitFull"
                          Disabled="@(_busy || _submitting)" />
        </div>
        break;

    case Phase.Result when _result is not null:
        <div class="pa-result">
            <PlayerScoreboard Label="@(_result.IsFinished && _target > TargetCount ? "Geschafft" : "Training beendet")"
                              Value="@_result.TotalThrows.ToString()" Status="Darts"
                              Tone="@(_target > TargetCount ? "success" : null)" />
            <PlayerStatGrid Stats="ResultStats" />
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" @onclick="Restart">Neues Training</button>
                <a href="player/training" class="pl-btn pl-btn--ghost">Alle Trainings</a>
            </div>
        </div>
        break;
}

@code {
    private enum Phase { Setup, Playing, Result }

    /// <summary>1–20, 21 = 25 (Single Bull), 22 = Bull; 23 = fertig (wie im Backend).</summary>
    private const int TargetCount = 22;
    private const int DartsPerVisit = 3;

    private Phase _phase = Phase.Setup;
    private bool _busy;
    private string? _error;

    private int _trainingId;
    private int _visitNumber = 1;
    private int _throwNumber = 1;
    private int _target = 1;
    private int _dartsThrown;
    private int _hits;
    private readonly List<DartThrowInput> _darts = [];
    /// <summary>Eingegebene, noch nicht gesendete Darts (Ende von _darts).</summary>
    private readonly List<DartThrowInput> _pending = [];
    private bool _submitting;
    private bool _clearDartsOnNext;

    /// <summary>Drei Darts in der Aufnahme: weitere erst nach dem Senden.</summary>
    private bool IsVisitFull => !_clearDartsOnNext && _darts.Count >= 3;
    private string? _status;
    private string? _tone;

    private AroundTheClockTrainingResult? _result;

    private IReadOnlyList<PlayerStat> LiveStats =>
    [
        new("Fortschritt", $"{_target - 1} / {TargetCount}"),
        new("Darts", _dartsThrown.ToString()),
        new("Trefferquote", _dartsThrown == 0 ? "–" : $"{_hits * 100.0 / _dartsThrown:0} %")
    ];

    private IReadOnlyList<PlayerStat> ResultStats => _result is null ? [] :
    [
        new("Trefferquote", $"{_result.HitRate:0.#} %", Highlight: true),
        new("Treffer", _result.TotalHits.ToString()),
        new("Fehlwürfe", _result.TotalMisses.ToString()),
        new("Aufnahmen", _result.TotalVisits.ToString()),
        new("Singles", _result.SingleHits.ToString()),
        new("Doubles", _result.DoubleHits.ToString()),
        new("Triples", _result.TripleHits.ToString()),
        new("25 / Bull", $"{_result.OuterBullHits} / {_result.InnerBullHits}")
    ];

    // Offenes Training nach Reload oder Navigation fortsetzen, sonst Einstellungen zeigen.
    protected override async Task OnInitializedAsync()
    {
        var running = await TrainingApi.GetRunningAroundTheClockAsync();

        if (!running.IsSuccess || running.Value is not { } training)
        {
            return;
        }

        _trainingId = training.TrainingId;
        _visitNumber = training.NextVisitNumber;
        _throwNumber = training.NextThrowNumber;
        _dartsThrown = training.DartsThrown;
        _darts.Clear();
        _pending.Clear();
        _darts.AddRange(training.CurrentVisitDarts.Select(d => new DartThrowInput(d.Segment, d.Multiplier)));
        _clearDartsOnNext = false;
        _target = training.CurrentTarget;
        _hits = training.Hits;
        _status = "Offenes Training fortgesetzt";
        _tone = null;
        _phase = Phase.Playing;
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;

        var result = await TrainingApi.StartAroundTheClockAsync();

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _trainingId = result.Value;
        _visitNumber = 1;
        _throwNumber = 1;
        _target = 1;
        _dartsThrown = 0;
        _hits = 0;
        _darts.Clear();
        _pending.Clear();
        _clearDartsOnNext = false;
        _status = "Los geht's mit der 1";
        _tone = null;
        _phase = Phase.Playing;
    }

    private void AddDart(DartThrowInput dart)
    {
        if (_clearDartsOnNext)
        {
            _darts.Clear();
            _clearDartsOnNext = false;
        }

        if (IsVisitFull)
        {
            return;
        }

        _error = null;
        _pending.Add(dart);
        _darts.Add(dart);
    }

    private void UndoDart()
    {
        if (_pending.Count == 0)
        {
            return;
        }

        _pending.RemoveAt(_pending.Count - 1);
        _darts.RemoveAt(_darts.Count - 1);
    }

    /// <summary>Schickt die gesammelten Darts nacheinander; der Server wertet jeden Dart wie bisher.</summary>
    private async Task SubmitVisitAsync()
    {
        if (_pending.Count == 0 || _submitting)
        {
            return;
        }

        var darts = _pending.ToList();
        _pending.Clear();
        _darts.RemoveRange(_darts.Count - darts.Count, darts.Count);
        _submitting = true;

        try
        {
            for (var i = 0; i < darts.Count; i++)
            {
                // Training ist vor dem letzten Dart beendet (oder die Aufnahme ist schon zu Ende): Rest verwerfen.
                if (i > 0 && (_clearDartsOnNext || _phase != Phase.Playing))
                {
                    break;
                }

                await CommitDartAsync(darts[i]);

                if (_error is not null)
                {
                    var rest = darts.Skip(i).ToList();
                    _pending.AddRange(rest);
                    _darts.AddRange(rest);
                    break;
                }
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CommitDartAsync(DartThrowInput dart)
    {
        _busy = true;
        _error = null;

        var result = await TrainingApi.AddAroundTheClockThrowAsync(new AroundTheClockTrainingThrow
        {
            TrainingId = _trainingId,
            VisitNumber = _visitNumber,
            ThrowNumber = _throwNumber,
            Segment = dart.Segment,
            Multiplier = dart.Multiplier
        });

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        var value = result.Value!;
        _darts.Add(dart);
        _dartsThrown++;
        _target = value.CurrentTarget;

        if (value.IsHit)
        {
            _hits++;
        }

        _status = value.IsHit ? $"Treffer! Weiter mit {TargetLabel(_target)}" : null;
        _tone = value.IsHit ? "success" : null;

        if (value.IsFinished)
        {
            await LoadResultAsync();
            return;
        }

        if (_throwNumber == DartsPerVisit)
        {
            _visitNumber++;
            _throwNumber = 1;
            _clearDartsOnNext = true;
        }
        else
        {
            _throwNumber++;
        }
    }

    private async Task FinishAsync()
    {
        _busy = true;
        var result = await TrainingApi.FinishAroundTheClockAsync(_trainingId);
        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        await LoadResultAsync();
    }

    private async Task LoadResultAsync()
    {
        var result = await TrainingApi.GetAroundTheClockResultAsync(_trainingId);

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _result = result.Value;
        _phase = Phase.Result;
    }

    private void Restart()
    {
        _result = null;
        _error = null;
        _phase = Phase.Setup;
    }

    private static string TargetLabel(int target) => target switch
    {
        21 => "25",
        22 => "Bull",
        > 22 => "✓",
        _ => target.ToString()
    };
}
