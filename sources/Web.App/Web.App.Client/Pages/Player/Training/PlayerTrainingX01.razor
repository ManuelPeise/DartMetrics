@page "/player/training/x01"
@using global::Shared.Enums.X01
@using global::Shared.Models.Remote
@using global::Shared.Models.Shared
@using global::Shared.Models.Training
@inject ITrainingApi TrainingApi
@inject PlayerProfileState Profile

<PageTitle>X01-Training – DartMetrics</PageTitle>

<PlayerPageHeader Eyebrow="Training" Title="X01" Subtitle="@Subtitle">
    <Actions>
        @if (_phase == Phase.Playing)
        {
            <button type="button" class="pl-btn pl-btn--ghost" disabled="@_busy" @onclick="FinishAsync">Beenden</button>
        }
        else
        {
            <a href="player/training" class="pl-btn pl-btn--link">← Alle Trainings</a>
        }
    </Actions>
</PlayerPageHeader>

@if (_error is not null)
{
    <PlayerErrorState Text="@_error" />
}

@switch (_phase)
{
    case Phase.Setup:
        <div class="pa-setup">
            <PlayerChoiceGroup Label="Startwert" Options="ScoreOptions" @bind-Value="_startingScore" />
            <PlayerChoiceGroup Label="Eröffnen" Options="InOptions" @bind-Value="_inMode" />
            <PlayerChoiceGroup Label="Beenden" Options="OutOptions" @bind-Value="_outMode" />
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" disabled="@_busy" @onclick="StartAsync">
                    @(_busy ? "Startet …" : "Training starten")
                </button>
            </div>
        </div>
        break;

    case Phase.Playing:
        <div class="pa-play">
            <div class="pa-play__info">
                <PlayerScoreboard Label="Rest" Value="@Preview.Remaining.ToString()" Status="@_status" Tone="@_tone">
                    <CheckoutHint Suggestions="ShownSuggestions" />
                </PlayerScoreboard>
                <PlayerStatGrid Stats="LiveStats" />
            </div>
            <DartInputPad CurrentDarts="_darts" OnDart="AddDart" OnUndo="UndoDart" CanUndo="@(_pending.Count > 0)"
                          OnSubmit="SubmitVisitAsync" CanSubmit="@(_pending.Count > 0)" InputLocked="@Preview.IsVisitFinished"
                          SubmitHint="@PreviewHint" SubmitHintTone="@PreviewTone" Disabled="@(_busy || _submitting)" />
        </div>
        break;

    case Phase.Result when _result is not null:
        <div class="pa-result">
            <PlayerScoreboard Label="@(_result.IsCheckout ? "Checkout geschafft" : "Training beendet")"
                              Value="@($"{_result.AverageScorePerVisit:0.0}")" Status="3-Dart-Average"
                              Tone="@(_result.IsCheckout ? "success" : null)" />
            <PlayerStatGrid Stats="ResultStats" />
            <div class="pa-setup__actions">
                <button type="button" class="pl-btn pl-btn--primary" @onclick="Restart">Neues Training</button>
                <a href="player/training" class="pl-btn pl-btn--ghost">Alle Trainings</a>
            </div>
        </div>
        break;
}

@* Außerhalb des switch, damit die Handy-Verbindung beim Wechsel Spiel → Ergebnis bestehen bleibt (Schlussansage). *@
@if (_phase is Phase.Playing or Phase.Result)
{
    <RemoteInputBridge State="RemoteDisplay" OnDart="AddDart" OnUndo="UndoDart" OnSubmit="SubmitVisitAsync" />
}

@code {
    private enum Phase { Setup, Playing, Result }

    private static readonly IReadOnlyList<PlayerChoice<int>> ScoreOptions = [new(301, "301"), new(501, "501")];

    private static readonly IReadOnlyList<PlayerChoice<X01InModeEnum>> InOptions =
    [
        new(X01InModeEnum.Straight, "Straight-In", "Jeder Dart zählt"),
        new(X01InModeEnum.Double, "Double-In", "Erst ab einem Double")
    ];

    private static readonly IReadOnlyList<PlayerChoice<X01OutModeEnum>> OutOptions =
    [
        new(X01OutModeEnum.Double, "Double-Out", "Finish mit Double"),
        new(X01OutModeEnum.Straight, "Straight-Out", "Jeder Dart zählt")
    ];

    private Phase _phase = Phase.Setup;
    private bool _busy;
    private string? _error;

    private int _startingScore = 501;
    private X01InModeEnum _inMode = X01InModeEnum.Straight;
    private X01OutModeEnum _outMode = X01OutModeEnum.Double;

    private int _trainingId;
    private int _visitNumber = 1;
    private int _throwNumber = 1;
    private int _remaining;
    private bool _opened = true;
    private int _dartsThrown;
    private int _busts;
    private int _leg = 1;
    private int _legsCompleted;
    private int _numberOfLegs = X01SetRules.TrainingBestOfLegs;
    private readonly List<DartThrowInput> _darts = [];
    /// <summary>Eingegebene, noch nicht gesendete Darts (Ende von _darts).</summary>
    private readonly List<DartThrowInput> _pending = [];
    private bool _submitting;
    private bool _clearDartsOnNext;
    private List<CheckoutSuggestion>? _suggestions;
    private string? _status;
    private string? _tone;

    private X01TrainingResult? _result;

    /// <summary>Darts der laufenden Aufnahme, die der Server schon gewertet hat (z. B. nach dem Fortsetzen).</summary>
    private int CommittedInVisit => _clearDartsOnNext ? 0 : _darts.Count - _pending.Count;

    /// <summary>Vorschau der noch nicht gesendeten Darts: Bust/Checkout sofort anzeigen, gewertet wird auf dem Server.</summary>
    private X01VisitPreviewResult Preview => X01VisitPreview.Evaluate(
        _remaining, _opened, _inMode, _outMode, CommittedInVisit, _pending.Select(d => (d.Segment, d.Multiplier)));

    private string? PreviewHint => _pending.Count == 0 ? null
        : Preview.IsCheckout ? "Checkout!"
        : Preview.IsBust ? "Bust"
        : null;

    private string? PreviewTone => Preview.IsCheckout ? "success" : Preview.IsBust ? "danger" : null;

    /// <summary>Während der Eingabe im Browser neu berechnet, sonst die Empfehlung des Servers.</summary>
    private List<CheckoutSuggestion>? ShownSuggestions =>
        _pending.Count == 0 ? _suggestions
        : Preview.IsVisitFinished || !Preview.IsOpened ? null
        : CheckoutAdvisor.GetBestRoutes(Preview.Remaining, X01VisitPreview.DartsPerVisit - CommittedInVisit - _pending.Count, _outMode);

    /// <summary>Anzeige für ein gekoppeltes Handy.</summary>
    private RemoteDisplayState RemoteDisplay => new()
    {
        Title = "X01-Training",
        Subtitle = $"{Subtitle} · Leg {_leg} / {_numberOfLegs}",
        Players = [new RemotePlayerState { Name = "Rest", Value = Preview.Remaining.ToString(), Detail = $"Aufnahme {_visitNumber}", IsActive = true }],
        Darts = RemoteState.Darts(_darts),
        VisitTotal = RemoteState.Total(_darts),
        Checkout = RemoteState.Checkout(ShownSuggestions),
        Status = _status,
        StatusTone = _tone,
        Hint = PreviewHint,
        HintTone = PreviewTone,
        CanInput = !_busy && !_submitting,
        InputLocked = Preview.IsVisitFinished,
        CanUndo = _pending.Count > 0,
        CanSubmit = _pending.Count > 0,
        IsFinished = _phase == Phase.Result,
        CallId = _callId,
        CallText = _callText
    };

    private int _callId;
    private string? _callText;
    private string? _playerName;

    private void Announce(string text)
    {
        _callText = text;
        _callId++;
    }

    private string Subtitle => _phase == Phase.Setup
        ? "Spiele einen Satz aus 5 Legs allein und verfolge deinen Average."
        : $"{_startingScore} · {(_inMode == X01InModeEnum.Double ? "Double-In" : "Straight-In")} · {(_outMode == X01OutModeEnum.Straight ? "Straight-Out" : "Double-Out")}";

    private IReadOnlyList<PlayerStat> LiveStats =>
    [
        new("Leg", $"{_leg} / {_numberOfLegs}"),
        new("Aufnahme", _visitNumber.ToString()),
        new("Darts", _dartsThrown.ToString()),
        // Punkte = gecheckte Legs voll + laufendes Leg.
        new("Average", _dartsThrown == 0 ? "–" : $"{(_legsCompleted * _startingScore + _startingScore - _remaining) * 3.0 / _dartsThrown:0.0}"),
        new("Busts", _busts.ToString())
    ];

    private IReadOnlyList<PlayerStat> ResultStats => _result is null ? [] :
    [
        new("Legs gecheckt", $"{_result.LegsCompleted} / {_result.NumberOfLegs}", Highlight: _result.LegsCompleted == _result.NumberOfLegs),
        new("Darts pro Leg", _result.AverageDartsPerLeg is { } d ? $"{d:0.0}" : "–"),
        new("Darts", _result.TotalThrows.ToString()),
        new("Aufnahmen", _result.TotalVisits.ToString()),
        new("Punkte", _result.TotalScore.ToString()),
        new("Ø pro Dart", $"{_result.AverageScorePerThrow:0.00}"),
        new("Busts", _result.Busts.ToString()),
        new("Triples", _result.TripleHits.ToString()),
        new("Doubles", _result.DoubleHits.ToString()),
        new("Misses", _result.Misses.ToString())
    ];

    // Offenes Training nach Reload oder Navigation fortsetzen, sonst Einstellungen zeigen.
    protected override async Task OnInitializedAsync()
    {
        _playerName = RemoteState.PlayerName(await Profile.EnsureLoadedAsync());

        var running = await TrainingApi.GetRunningX01Async();

        if (!running.IsSuccess || running.Value is not { } training)
        {
            return;
        }

        _trainingId = training.TrainingId;
        _visitNumber = training.NextVisitNumber;
        _throwNumber = training.NextThrowNumber;
        _dartsThrown = training.DartsThrown;
        _darts.Clear();
        _pending.Clear();
        _darts.AddRange(training.CurrentVisitDarts.Select(d => new DartThrowInput(d.Segment, d.Multiplier)));
        _clearDartsOnNext = false;
        _startingScore = training.StartingScore;
        _inMode = training.InMode;
        _outMode = training.OutMode;
        _remaining = training.RemainingScore;
        _opened = training.IsOpened;
        _busts = training.Busts;
        _leg = training.LegNumber;
        _legsCompleted = training.LegsCompleted;
        _numberOfLegs = training.NumberOfLegs;
        _suggestions = training.CheckoutSuggestions.Count > 0 ? training.CheckoutSuggestions : null;
        _status = "Offenes Training fortgesetzt";
        _tone = null;
        _phase = Phase.Playing;
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;

        var result = await TrainingApi.StartX01Async(new StartX01TrainingModel
        {
            StartingScore = _startingScore,
            InMode = _inMode,
            OutMode = _outMode
        });

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _trainingId = result.Value;
        _visitNumber = 1;
        _throwNumber = 1;
        _remaining = _startingScore;
        _opened = _inMode == X01InModeEnum.Straight;
        _dartsThrown = 0;
        _busts = 0;
        _leg = 1;
        _legsCompleted = 0;
        _numberOfLegs = X01SetRules.TrainingBestOfLegs;
        _darts.Clear();
        _pending.Clear();
        _clearDartsOnNext = false;
        _suggestions = null;
        _status = _opened ? "Los geht's!" : "Zum Eröffnen ein Double treffen";
        Announce(RemoteState.LegStartCall(_playerName));
        _tone = null;
        _phase = Phase.Playing;
    }

    private void AddDart(DartThrowInput dart)
    {
        // Nach Ende einer Aufnahme bleiben deren Darts sichtbar, bis der nächste Dart kommt.
        if (_clearDartsOnNext)
        {
            _darts.Clear();
            _clearDartsOnNext = false;
        }

        if (Preview.IsVisitFinished)
        {
            return;
        }

        _error = null;
        _pending.Add(dart);
        _darts.Add(dart);
    }

    private void UndoDart()
    {
        if (_pending.Count == 0)
        {
            return;
        }

        _pending.RemoveAt(_pending.Count - 1);
        _darts.RemoveAt(_darts.Count - 1);
    }

    /// <summary>Schickt die gesammelten Darts nacheinander; der Server wertet jeden Dart wie bisher.</summary>
    private async Task SubmitVisitAsync()
    {
        if (_pending.Count == 0 || _submitting)
        {
            return;
        }

        var darts = _pending.ToList();

        // Ansage fürs Handy, sobald die Aufnahme laut Vorschau zu Ende ist.
        if (Preview.IsVisitFinished)
        {
            _callText = RemoteState.CallText(_remaining - Preview.Remaining, Preview.IsBust, Preview.IsCheckout);
            _callId++;
        }

        _pending.Clear();
        _darts.RemoveRange(_darts.Count - darts.Count, darts.Count);
        _submitting = true;

        try
        {
            for (var i = 0; i < darts.Count; i++)
            {
                // Server hat die Aufnahme früher beendet als die Vorschau: übrige Darts nicht in die nächste Aufnahme schieben.
                if (i > 0 && (_clearDartsOnNext || _phase != Phase.Playing))
                {
                    _error = $"Die Aufnahme war nach Dart {i} beendet – die übrigen Darts wurden nicht gewertet.";
                    break;
                }

                await CommitDartAsync(darts[i]);

                if (_error is not null)
                {
                    // Nicht gewertete Darts bleiben stehen und können korrigiert oder erneut gesendet werden.
                    var rest = darts.Skip(i).ToList();
                    _pending.AddRange(rest);
                    _darts.AddRange(rest);
                    break;
                }
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task CommitDartAsync(DartThrowInput dart)
    {
        _busy = true;
        _error = null;

        var result = await TrainingApi.AddX01ThrowAsync(new X01TrainingThrow
        {
            TrainingId = _trainingId,
            VisitNumber = _visitNumber,
            ThrowNumber = _throwNumber,
            Segment = dart.Segment,
            Multiplier = dart.Multiplier
        });

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        var value = result.Value!;
        _darts.Add(dart);
        _dartsThrown++;
        _remaining = value.RemainingScore;
        _suggestions = value.CheckoutSuggestions;

        var wasOpened = _opened;
        _opened = value.IsOpened;

        _leg = value.LegNumber;
        _legsCompleted = value.LegsCompleted;
        _numberOfLegs = value.NumberOfLegs;

        if (value.IsSetFinished)
        {
            Announce(RemoteState.TrainingCompleteCall(_playerName));
            await LoadResultAsync();
            return;
        }

        if (value.IsCheckout)
        {
            // Nächstes Leg im Satz: wieder beim Startwert.
            _status = $"Leg {_leg} gecheckt – weiter mit Leg {_leg + 1} von {_numberOfLegs}";
            // „Game shot!“ kommt aus der Ansage der Aufnahme, dazu der Start des nächsten Legs.
            _callText = $"{_callText} {RemoteState.LegStartCall(_playerName)}".Trim();
            _tone = "success";
            _leg++;
            _remaining = _startingScore;
            _opened = _inMode == X01InModeEnum.Straight;
            NextVisit();
            return;
        }

        if (value.IsBust)
        {
            _busts++;
            _status = "Bust – die Aufnahme zählt nicht";
            _tone = "danger";
            NextVisit();
            return;
        }

        _status = !_opened ? "Noch nicht eröffnet – Double treffen"
            : !wasOpened ? "Eröffnet!"
            : null;
        _tone = !wasOpened && _opened ? "success" : null;

        if (value.RemainingDarts == 0)
        {
            NextVisit();
        }
        else
        {
            _throwNumber++;
        }
    }

    private void NextVisit()
    {
        _visitNumber++;
        _throwNumber = 1;
        // _suggestions bleibt: der Server liefert nach Aufnahme-Ende/Bust schon die Empfehlung für die nächste Aufnahme.
        _clearDartsOnNext = true;
    }

    private async Task FinishAsync()
    {
        _busy = true;
        var result = await TrainingApi.FinishX01Async(_trainingId);
        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        await LoadResultAsync();
    }

    private async Task LoadResultAsync()
    {
        var result = await TrainingApi.GetX01ResultAsync(_trainingId);

        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _result = result.Value;
        _phase = Phase.Result;
    }

    private void Restart()
    {
        _result = null;
        _error = null;
        _phase = Phase.Setup;
    }
}
