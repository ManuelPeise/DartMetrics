@typeparam TItem
@*
    Tabelle mit mobiler Kartenansicht: jede Zelle im RowTemplate bekommt data-label="…",
    das auf dem Smartphone als Beschriftung vor dem Wert erscheint.
*@
@if (IsLoading)
{
    <AdminLoadingState />
}
else if (ErrorText is not null)
{
    <AdminErrorState Text="@ErrorText" OnRetry="OnRetry" />
}
else if (Items is null || !Items.Any())
{
    @if (EmptyContent is not null)
    {
        @EmptyContent
    }
    else
    {
        <AdminEmptyState Title="Keine Einträge" />
    }
}
else
{
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead><tr>@HeaderTemplate</tr></thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr @key="item">@RowTemplate(item)</tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    [Parameter, EditorRequired] public RenderFragment HeaderTemplate { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    [Parameter] public RenderFragment? EmptyContent { get; set; }

    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Gesetzt = Fehlerzustand mit diesem Text.</summary>
    [Parameter] public string? ErrorText { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnRetry { get; set; }
}
