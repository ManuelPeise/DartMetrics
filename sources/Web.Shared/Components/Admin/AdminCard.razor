<section class="adm-card @Class">
    @if (!string.IsNullOrEmpty(Title) || Actions is not null)
    {
        <header class="adm-card__header">
            <div>
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h2 class="adm-card__title">@Title</h2>
                }
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="adm-card__subtitle">@Subtitle</p>
                }
            </div>
            @Actions
        </header>
    }
    <div class="adm-card__body @(Flush ? "adm-card__body--flush" : "")">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Ohne Innenabstand, z. B. für Tabellen und Listen.</summary>
    [Parameter] public bool Flush { get; set; }

    [Parameter] public string? Class { get; set; }
}
