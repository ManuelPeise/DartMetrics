<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Web.Shared wird nur vom Server (Web.App) verwendet: Cookie-Anmeldung, Sitzungen, API-Client, Admin-Komponenten.
    Deshalb das ASP.NET-Core-Shared-Framework statt einzelner Pakete. Die früheren 2.x-Pakete
    (Microsoft.AspNetCore.Authentication / .Cookies 2.3.14) zogen Microsoft.AspNetCore.WebUtilities 2.3.12
    mit einer bekannten Sicherheitslücke nach (NU1902, GHSA-6527-9fp8-r4x6).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Interfaces\Shared.Interfaces.csproj" />
  </ItemGroup>

</Project>
